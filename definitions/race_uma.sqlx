-- CTE Step1: 全てのソーステーブルを結合し、基本的な整形を行うベーステーブルを作成
WITH
  races_uma_odds_kol AS (
    SELECT * FROM ${ref("jvd_odds", "races_uma_odds_kol")}
  ),
  base_data AS (
    SELECT
      d2.race_code_uma_kol,
      SUBSTR(d2.race_code_uma_kol, 1, 16) AS race_code_kol,
      CASE d2.keibajo_code WHEN '08' THEN '01' WHEN '09' THEN '02' WHEN '06' THEN '03' WHEN '07' THEN '04' WHEN '04' THEN '05' WHEN '05' THEN '06' WHEN '02' THEN '07' WHEN '00' THEN '08' WHEN '01' THEN '09' WHEN '03' THEN '10' ELSE NULL END AS keibajo_code_jvd_from_kol,
      d2.kaisai_nengappi,
      d2.kaisai_kaiji,
      d2.kaisai_nichiji,
      d2.race_num,
      d2.umaban,
      d2.ketto_toroku_bango,
      DATETIME_ADD(PARSE_DATETIME('%Y%m%d%H%M', d2.kaisai_nengappi || REPLACE(d1.hasso_jikoku, ':', '')), INTERVAL 9 HOUR) AS hasso_date,
      d2.wakuban,
      d2.bamei,
      d2.seibetsu_code,
      d2.barei,
      d2.futan_juryo,
      d2.blinker_shiyo_kubun,
      d2.rating,
      d2.banushimei,
      d2.banushimei_ryakusho,
      d2.kyuyo_riyu,
      d2.kishu_code,
      d2.kishumei,
      d2.kishumei_ryakusho,
      d2.kishu_tozai_shozoku_code,
      d2.kishu_minarai_code,
      d2.kishu_norikawari_kubun,
      d2.kishu_shozokubasho_code,
      d2.kishu_shozoku_chokyoshi_code,
      d2.chokyoshi_code,
      d2.chokyoshimei,
      d2.chokyoshimei_ryakusho,
      d2.chokyoshi_shozokubasho_code,
      d2.chokyoshi_tracen_kubun,
      d2.keibajo_code,
      d2.speed_shisu1,
      d2.speed_shisu2,
      d2.speed_shisu3,
      d2.speed_shisu4,
      d2.speed_shisu5,
      d2.rotation1,
      d2.rotation2,
      d2.rotation3,
      d2.rotation4,
      d2.rotation5,
      d2.rotation6,
      d2.rotation7,
      d2.rotation8,
      s2.record_shisu,
      s2.bataiju,
      s2.zogen_sa,
      s2.tansho_ninkijun,
      s2.tansho_odds,
      s2.kakutei_chakujun,
      s2.nyusen_juni,
      s2.ijo_kubun_code1,
      s2.ijo_kubun_code2,
      s2.record_flag,
      s2.soha_time,
      s2.time_sa,
      s2.zenhan_3f,
      s2.kohan_3f,
      s2.chakusa_code1,
      s2.chakusa_code2,
      s2.corner1_juni,
      s2.corner2_juni,
      s2.corner3_juni,
      s2.corner4_juni,
      s2.corner4_ichidori,
      o1.YosouTanNinki,
      o1.YosouTanOdds,
      -- Chokyo Dynamic Selection Logic
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_flag
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_flag
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_flag
        ELSE NULL -- default? or s2.chokyo_flag? User implied d2 only.
      END AS chokyo_den_oikiri_flag,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_kijosha
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_kijosha
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_kijosha
        ELSE NULL
      END AS chokyo_den_oikiri_kijosha,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_nengappi
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_nengappi
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_nengappi
        ELSE NULL
      END AS chokyo_den_oikiri_nengappi,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_basho
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_basho
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_basho
        ELSE NULL
      END AS chokyo_den_oikiri_basho,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_course
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_course
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_course
        ELSE NULL
      END AS chokyo_den_oikiri_course,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_babajotai
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_babajotai
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_babajotai
        ELSE NULL
      END AS chokyo_den_oikiri_babajotai,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_8f
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_8f
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_8f
        ELSE NULL
      END AS chokyo_den_oikiri_8f_d2,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_7f
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_7f
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_7f
        ELSE NULL
      END AS chokyo_den_oikiri_7f_d2,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_6f
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_6f
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_6f
        ELSE NULL
      END AS chokyo_den_oikiri_6f_d2,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_5f
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_5f
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_5f
        ELSE NULL
      END AS chokyo_den_oikiri_5f_d2,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_4f
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_4f
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_4f
        ELSE NULL
      END AS chokyo_den_oikiri_4f_d2,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_3f
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_3f
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_3f
        ELSE NULL
      END AS chokyo_den_oikiri_3f_d2,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_1f
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_1f
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_1f
        ELSE NULL
      END AS chokyo_den_oikiri_1f_d2,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_ichidori
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_ichidori
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_ichidori
        ELSE NULL
      END AS chokyo_den_oikiri_ichidori,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_ashiiro
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_ashiiro
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_ashiiro
        ELSE NULL
      END AS chokyo_den_oikiri_ashiiro,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_yajirushi
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_yajirushi
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_yajirushi
        ELSE NULL
      END AS chokyo_den_oikiri_yajirushi,
      CASE
        WHEN d2.chokyo1_flag = '1' THEN d2.chokyo1_reigai
        WHEN d2.chokyo2_flag = '1' THEN d2.chokyo2_reigai
        WHEN d2.chokyo3_flag = '1' THEN d2.chokyo3_reigai
        ELSE NULL
      END AS chokyo_den_oikiri_reigai,
      d2.chokyo_awase AS chokyo_den_oikiri_awase,
      REGEXP_EXTRACT(d2.chokyo_awase, r'^(.+?)に') AS chokyo_den_oikiri_awase_uma_bamei,
      d2.chokyo_awase_flag AS chokyo_den_oikiri_awase_flag,
      d2.chokyo_tanpyo AS chokyo_den_oikiri_tanpyo,
      d2.chokyo_honsu_course AS chokyo_den_oikiri_honsu_course,
      d2.chokyo_honsu_hanro AS chokyo_den_oikiri_honsu_hanro,
      d2.chokyo_honsu_pool AS chokyo_den_oikiri_honsu_pool,
      -- 調教1
      d2.chokyo1_flag AS chokyo_den_chokyo1_flag,
      d2.chokyo1_kijosha AS chokyo_den_chokyo1_kijosha,
      d2.chokyo1_nengappi AS chokyo_den_chokyo1_nengappi,
      DATE(DATETIME_ADD(PARSE_DATETIME('%Y%m%d', d2.chokyo1_nengappi), INTERVAL 9 HOUR)) AS chokyo_den_chokyo1_nengappi_date,
      d2.chokyo1_basho AS chokyo_den_chokyo1_basho,
      d2.chokyo1_course AS chokyo_den_chokyo1_course,
      d2.chokyo1_babajotai AS chokyo_den_chokyo1_babajotai,
      d2.chokyo1_8f AS chokyo_den_chokyo1_8f,
      d2.chokyo1_7f AS chokyo_den_chokyo1_7f,
      d2.chokyo1_6f AS chokyo_den_chokyo1_6f,
      d2.chokyo1_5f AS chokyo_den_chokyo1_5f,
      d2.chokyo1_4f AS chokyo_den_chokyo1_4f,
      d2.chokyo1_3f AS chokyo_den_chokyo1_3f,
      d2.chokyo1_1f AS chokyo_den_chokyo1_1f,
      d2.chokyo1_ichidori AS chokyo_den_chokyo1_ichidori,
      d2.chokyo1_ashiiro AS chokyo_den_chokyo1_ashiiro,
      d2.chokyo1_yajirushi AS chokyo_den_chokyo1_yajirushi,
      d2.chokyo1_reigai AS chokyo_den_chokyo1_reigai,
      -- 調教2
      d2.chokyo2_flag AS chokyo_den_chokyo2_flag,
      d2.chokyo2_kijosha AS chokyo_den_chokyo2_kijosha,
      d2.chokyo2_nengappi AS chokyo_den_chokyo2_nengappi,
      DATE(DATETIME_ADD(PARSE_DATETIME('%Y%m%d', d2.chokyo2_nengappi), INTERVAL 9 HOUR)) AS chokyo_den_chokyo2_nengappi_date,
      d2.chokyo2_basho AS chokyo_den_chokyo2_basho,
      d2.chokyo2_course AS chokyo_den_chokyo2_course,
      d2.chokyo2_babajotai AS chokyo_den_chokyo2_babajotai,
      d2.chokyo2_8f AS chokyo_den_chokyo2_8f,
      d2.chokyo2_7f AS chokyo_den_chokyo2_7f,
      d2.chokyo2_6f AS chokyo_den_chokyo2_6f,
      d2.chokyo2_5f AS chokyo_den_chokyo2_5f,
      d2.chokyo2_4f AS chokyo_den_chokyo2_4f,
      d2.chokyo2_3f AS chokyo_den_chokyo2_3f,
      d2.chokyo2_1f AS chokyo_den_chokyo2_1f,
      d2.chokyo2_ichidori AS chokyo_den_chokyo2_ichidori,
      d2.chokyo2_ashiiro AS chokyo_den_chokyo2_ashiiro,
      d2.chokyo2_yajirushi AS chokyo_den_chokyo2_yajirushi,
      d2.chokyo2_reigai AS chokyo_den_chokyo2_reigai,
      -- 調教3
      d2.chokyo3_flag AS chokyo_den_chokyo3_flag,
      d2.chokyo3_kijosha AS chokyo_den_chokyo3_kijosha,
      d2.chokyo3_nengappi AS chokyo_den_chokyo3_nengappi,
      DATE(DATETIME_ADD(PARSE_DATETIME('%Y%m%d', d2.chokyo3_nengappi), INTERVAL 9 HOUR)) AS chokyo_den_chokyo3_nengappi_date,
      d2.chokyo3_basho AS chokyo_den_chokyo3_basho,
      d2.chokyo3_course AS chokyo_den_chokyo3_course,
      d2.chokyo3_babajotai AS chokyo_den_chokyo3_babajotai,
      d2.chokyo3_8f AS chokyo_den_chokyo3_8f,
      d2.chokyo3_7f AS chokyo_den_chokyo3_7f,
      d2.chokyo3_6f AS chokyo_den_chokyo3_6f,
      d2.chokyo3_5f AS chokyo_den_chokyo3_5f,
      d2.chokyo3_4f AS chokyo_den_chokyo3_4f,
      d2.chokyo3_3f AS chokyo_den_chokyo3_3f,
      d2.chokyo3_1f AS chokyo_den_chokyo3_1f,
      d2.chokyo3_ichidori AS chokyo_den_chokyo3_ichidori,
      d2.chokyo3_ashiiro AS chokyo_den_chokyo3_ashiiro,
      d2.chokyo3_yajirushi AS chokyo_den_chokyo3_yajirushi,
      d2.chokyo3_reigai AS chokyo_den_chokyo3_reigai,
      -- 調教 (sei2由来)
      s2.chokyo_flag AS chokyo_sei_flag,
      s2.chokyo_kijosha AS chokyo_sei_kijosha,
      CASE
        WHEN s2.chokyo_kijosha IS NULL THEN NULL
        WHEN s2.chokyo_kijosha = '調教師' THEN '調教師'
        WHEN s2.chokyo_kijosha = '見習' THEN '見習'
        WHEN s2.chokyo_kijosha IN ('厩舎', '助手') THEN '厩舎'
        ELSE '騎手'
      END AS chokyo_sei_kijosha_kubun,
      s2.chokyo_nengappi AS chokyo_sei_nengappi,
      s2.chokyo_basho AS chokyo_sei_basho,
      s2.chokyo_course AS chokyo_sei_course,
      s2.chokyo_babajotai AS chokyo_sei_babajotai,
      s2.chokyo_8f AS chokyo_sei_8f,
      s2.chokyo_7f AS chokyo_sei_7f,
      s2.chokyo_6f AS chokyo_sei_6f,
      s2.chokyo_5f AS chokyo_sei_5f,
      s2.chokyo_4f AS chokyo_sei_4f,
      s2.chokyo_3f AS chokyo_sei_3f,
      s2.chokyo_1f AS chokyo_sei_1f,
      s2.chokyo_ichidori AS chokyo_sei_ichidori,
      s2.chokyo_ashiiro AS chokyo_sei_ashiiro,
      s2.chokyo_yajirushi AS chokyo_sei_yajirushi,
      s2.chokyo_reigai AS chokyo_sei_reigai,

      k.ketto1_f_hanshoku_toroku_bango,
      k.ketto1_f_bamei,
      k.ketto2_m_hanshoku_toroku_bango,
      k.ketto2_m_bamei,
      k.ketto5_mf_hanshoku_toroku_bango,
      k.ketto5_mf_bamei,
      d1.kyoso_joken_kubun,
      CASE d1.kyoso_joken_kubun
        WHEN '00001' THEN '新馬'
        WHEN '00002' THEN '未出走'
        WHEN '00003' THEN '未勝利'
        WHEN '00004' THEN 'オープン'
        WHEN '05000' THEN '1勝クラス'
        WHEN '10000' THEN '2勝クラス'
        WHEN '16000' THEN '3勝クラス'
        ELSE NULL
      END AS kyoso_joken_kubun_label,
      CASE
        WHEN d1.kyoso_joken_kubun IN ('00001', '00002') THEN 1
        WHEN d1.kyoso_joken_kubun = '00003' THEN 2
        WHEN d1.kyoso_joken_kubun = '05000' THEN 3
        WHEN d1.kyoso_joken_kubun = '10000' THEN 4
        WHEN d1.kyoso_joken_kubun = '16000' THEN 5
        WHEN d1.kyoso_joken_kubun = '00004' THEN 6
        ELSE 0
      END AS kyoso_joken_rank_int,
      SAFE_CAST(d1.kyori AS INT64) AS kyori,
      CASE
        WHEN SAFE_CAST(d1.kyori AS INT64) <= 1399 THEN '短距離'
        WHEN SAFE_CAST(d1.kyori AS INT64) BETWEEN 1400 AND 1699 THEN 'マイル'
        WHEN SAFE_CAST(d1.kyori AS INT64) BETWEEN 1700 AND 2099 THEN '中距離'
        WHEN SAFE_CAST(d1.kyori AS INT64) >= 2100 THEN '長距離'
        ELSE NULL
      END AS kyori_kubun,
      CASE s1.track_code1_dirtsiba
        WHEN '1' THEN '芝'
        WHEN '0' THEN 'ダ'
        ELSE NULL
      END AS track_code1_dirtsiba_label,
      SAFE_CAST(d1.toroku_tosu AS INT64) AS toroku_tosu_num,
      s1.tansho1_umaban,
      s1.tansho1_haraimodoshikin,
      s1.tansho2_umaban,
      s1.tansho2_haraimodoshikin,
      s1.tansho3_umaban,
      s1.tansho3_haraimodoshikin,
      s1.fukusho1_umaban,
      s1.fukusho1_haraimodoshikin,
      s1.fukusho2_umaban,
      s1.fukusho2_haraimodoshikin,
      s1.fukusho3_umaban,
      s1.fukusho3_haraimodoshikin,
      s1.fukusho4_umaban,
      s1.fukusho4_haraimodoshikin,
      s1.fukusho5_umaban,
      s1.fukusho5_haraimodoshikin,
      c1.comment_kishu_kyusha,
      c1.comment_next,
      c1.comment_last
    FROM
      ${ref("kol_den2")} AS d2
    LEFT JOIN
      ${ref("kol_den1")} AS d1 ON SUBSTR(d2.race_code_uma_kol, 1, 16) = d1.race_code_kol
    LEFT JOIN
      ${ref("kol_sei2")} AS s2 ON d2.race_code_uma_kol = s2.race_code_uma_kol
    LEFT JOIN
      ${ref("kol_sei1")} AS s1 ON SUBSTR(d2.race_code_uma_kol, 1, 16) = s1.race_code_kol
    LEFT JOIN
      ${ref("kol_ket")} AS k ON d2.ketto_toroku_bango = k.ketto_toroku_bango_kol
    LEFT JOIN
      ${ref("kol_com1")} AS c1 ON d2.race_code_uma_kol = c1.race_code_uma_kol
    LEFT JOIN
      ${ref("races_uma_odds_kol")} AS o1 ON d2.race_code_uma_kol = o1.RaceUmaCode
  ),

-- CTE Step2: ウィンドウ関数を使い、馬ごとに1つ前のレース情報を取得
  with_zensou_data AS (
    SELECT
      *,
      CASE
        WHEN chokyo_den_oikiri_course = '坂' THEN '坂路'
        WHEN chokyo_den_oikiri_course = 'Ｐ' OR chokyo_den_oikiri_course = 'P' THEN 'ポリトラック'
        WHEN chokyo_den_oikiri_basho = 'プール' THEN 'プール'
        ELSE 'コース'
      END AS chokyo_den_oikiri_course_kubun,
      CASE
        WHEN chokyo_sei_course = '坂' THEN '坂路'
        WHEN chokyo_sei_course = 'Ｐ' OR chokyo_sei_course = 'P' THEN 'ポリトラック'
        WHEN chokyo_sei_basho = 'プール' THEN 'プール'
        ELSE 'コース'
      END AS chokyo_sei_course_kubun,

      -- 前走データの取得ロジック
      -- PARTITION BY は race_code_uma_kol (馬毎) で行う
      LAG(race_code_kol) OVER (PARTITION BY race_code_uma_kol ORDER BY hasso_date, race_code_kol) AS text_zensou_race_code_kol,
      LAG(bataiju, 1) OVER (PARTITION BY ketto_toroku_bango ORDER BY hasso_date) AS bataiju_zensou,
      LAG(kyori_kubun, 1) OVER (PARTITION BY ketto_toroku_bango ORDER BY hasso_date) AS kyori_kubun_zensou,
      LAG(kyori, 1) OVER (PARTITION BY ketto_toroku_bango ORDER BY hasso_date) AS kyori_zensou,
      LAG(track_code1_dirtsiba_label, 1) OVER (PARTITION BY ketto_toroku_bango ORDER BY hasso_date) AS track_code1_label_dirtsiba_zensou
    FROM
      base_data
  ),

  -- 【追加】馬ごとの「その日の直前のレースID」を事前に算出しておく
  partner_lookup AS (
    SELECT
      z.race_code_uma_kol,
      p.race_code_uma_kol AS race_code_uma_kol_partner,
      SUBSTR(p.race_code_uma_kol, 1, 16) AS race_code_kol_partner,
      d1.kyoso_joken_kubun,
      s2.kakutei_chakujun AS partner_last_race_chakujun,
      CASE d1.kyoso_joken_kubun
        WHEN '00001' THEN '新馬'
        WHEN '00002' THEN '未出走'
        WHEN '00003' THEN '未勝利'
        WHEN '00004' THEN 'オープン'
        WHEN '05000' THEN '1勝クラス'
        WHEN '10000' THEN '2勝クラス'
        WHEN '16000' THEN '3勝クラス'
        ELSE NULL
      END AS kyoso_joken_kubun_label,
      CASE
        WHEN s2.kakutei_chakujun = '01' AND d1.kyoso_joken_kubun IN ('00001', '00002') THEN 3 -- 新馬/未出走 優勝 -> 1勝クラス(3)
        WHEN s2.kakutei_chakujun = '01' AND d1.kyoso_joken_kubun = '00003' THEN 3 -- 未勝利 優勝 -> 1勝クラス(3)
        WHEN s2.kakutei_chakujun = '01' AND d1.kyoso_joken_kubun = '05000' THEN 4 -- 1勝クラス 優勝 -> 2勝クラス(4)
        WHEN s2.kakutei_chakujun = '01' AND d1.kyoso_joken_kubun = '10000' THEN 5 -- 2勝クラス 優勝 -> 3勝クラス(5)
        WHEN s2.kakutei_chakujun = '01' AND d1.kyoso_joken_kubun = '16000' THEN 6 -- 3勝クラス 優勝 -> オープン(6)

        -- 勝っていない、またはオープン馬の場合
        WHEN d1.kyoso_joken_kubun IN ('00001', '00002') THEN 1
        WHEN d1.kyoso_joken_kubun = '00003' THEN 2
        WHEN d1.kyoso_joken_kubun = '05000' THEN 3
        WHEN d1.kyoso_joken_kubun = '10000' THEN 4
        WHEN d1.kyoso_joken_kubun = '16000' THEN 5
        WHEN d1.kyoso_joken_kubun = '00004' THEN 6
        ELSE 0
      END AS kyoso_joken_rank_int
    FROM
      with_zensou_data AS z
    INNER JOIN
      ${ref("kol_den2")} AS p
      ON z.chokyo_den_oikiri_awase_uma_bamei = p.bamei
    LEFT JOIN
      ${ref("kol_den1")} AS d1
      ON SUBSTR(p.race_code_uma_kol, 1, 16) = d1.race_code_kol
    LEFT JOIN
      ${ref("kol_sei2")} AS s2
      ON p.race_code_uma_kol = s2.race_code_uma_kol
    WHERE
      z.chokyo_den_oikiri_awase_uma_bamei IS NOT NULL AND z.chokyo_den_oikiri_awase_uma_bamei != ''
      -- 併せ当時のクラスを取得するため、調教日(chokyo_den_oikiri_nengappi)より前のレースを参照する
      -- 調教日が取得できない場合は、発走日(kaisai_nengappi)を代用する
      AND p.kaisai_nengappi < COALESCE(z.chokyo_den_oikiri_nengappi, z.kaisai_nengappi)
    QUALIFY
      ROW_NUMBER() OVER (PARTITION BY z.race_code_uma_kol ORDER BY p.kaisai_nengappi DESC) = 1
  ),

  -- CTE: Shirushi Logic Calculation
  shirushi_calc_raw AS (
    SELECT
      race_code_uma_kol,
      SUBSTR(race_code_uma_kol, 1, 16) AS race_code_kol,
      chokyo_den_oikiri_awase,
      -- Hanro (Slope) Logic
      CASE
        WHEN chokyo_den_oikiri_course_kubun = '坂路' AND chokyo_den_oikiri_4f_d2 IS NOT NULL
        THEN RANK() OVER (
          PARTITION BY SUBSTR(race_code_uma_kol, 1, 16), IF(chokyo_den_oikiri_course_kubun = '坂路', 1, 0)
          ORDER BY SAFE_CAST(REGEXP_REPLACE(chokyo_den_oikiri_4f_d2, r'[^0-9.]', '') AS FLOAT64) ASC
        )
        ELSE NULL
      END AS hanro_4f_rank,
      CASE
        WHEN chokyo_den_oikiri_course_kubun = '坂路' AND chokyo_den_oikiri_1f_d2 IS NOT NULL
        THEN RANK() OVER (
          PARTITION BY SUBSTR(race_code_uma_kol, 1, 16), IF(chokyo_den_oikiri_course_kubun = '坂路', 1, 0)
          ORDER BY SAFE_CAST(REGEXP_REPLACE(chokyo_den_oikiri_1f_d2, r'[^0-9.]', '') AS FLOAT64) ASC
        )
        ELSE NULL
      END AS hanro_1f_rank,

      -- Wood Logic
      CASE
        WHEN ((chokyo_den_oikiri_basho = '栗東' AND chokyo_den_oikiri_course = 'CW') OR (chokyo_den_oikiri_basho = '美南' AND chokyo_den_oikiri_course = 'Ｗ'))
             AND chokyo_den_oikiri_6f_d2 IS NOT NULL
        THEN RANK() OVER (
          PARTITION BY SUBSTR(race_code_uma_kol, 1, 16),
          IF(((chokyo_den_oikiri_basho = '栗東' AND chokyo_den_oikiri_course = 'CW') OR (chokyo_den_oikiri_basho = '美南' AND chokyo_den_oikiri_course = 'Ｗ')), 1, 0)
          ORDER BY SAFE_CAST(REGEXP_REPLACE(chokyo_den_oikiri_6f_d2, r'[^0-9.]', '') AS FLOAT64) ASC
        )
        ELSE NULL
      END AS wood_6f_rank,
      CASE
        WHEN ((chokyo_den_oikiri_basho = '栗東' AND chokyo_den_oikiri_course = 'CW') OR (chokyo_den_oikiri_basho = '美南' AND chokyo_den_oikiri_course = 'Ｗ'))
             AND chokyo_den_oikiri_1f_d2 IS NOT NULL
        THEN RANK() OVER (
          PARTITION BY SUBSTR(race_code_uma_kol, 1, 16),
          IF(((chokyo_den_oikiri_basho = '栗東' AND chokyo_den_oikiri_course = 'CW') OR (chokyo_den_oikiri_basho = '美南' AND chokyo_den_oikiri_course = 'Ｗ')), 1, 0)
          ORDER BY SAFE_CAST(REGEXP_REPLACE(chokyo_den_oikiri_1f_d2, r'[^0-9.]', '') AS FLOAT64) ASC
        )
        ELSE NULL
      END AS wood_1f_rank,

      -- Odds Logic
      CAST(YosouTanNinki AS INT64) AS yosou_tansho_ninkijun_num,
      CAST(YosouTanOdds AS FLOAT64) AS yosou_tansho_odds_float

    FROM with_zensou_data
  ),

  shirushi_flags AS (
    SELECT
      *,
      IF(hanro_4f_rank = 1, 1, 0) AS shirushi_hanro_4f_flag_int,
      IF(hanro_1f_rank = 1, 1, 0) AS shirushi_hanro_1f_flag_int,
      IF(wood_6f_rank = 1, 1, 0) AS shirushi_wood_6f_flag_int,
      IF(wood_1f_rank = 1, 1, 0) AS shirushi_wood_1f_flag_int
    FROM shirushi_calc_raw
  ),

  shirushi_points AS (
    SELECT
      *,
      (shirushi_hanro_4f_flag_int + shirushi_hanro_1f_flag_int + shirushi_wood_6f_flag_int + shirushi_wood_1f_flag_int) AS shirushi_point
    FROM shirushi_flags
  ),

  shirushi_calc AS (
    SELECT
      *,
      IF(shirushi_hanro_4f_flag_int = 1, 'はい', NULL) AS shirushi_hanro_4f_flag,
      IF(shirushi_hanro_1f_flag_int = 1, 'はい', NULL) AS shirushi_hanro_1f_flag,
      IF(shirushi_wood_6f_flag_int = 1, 'はい', NULL) AS shirushi_wood_6f_flag,
      IF(shirushi_wood_1f_flag_int = 1, 'はい', NULL) AS shirushi_wood_1f_flag,
      IF(shirushi_point > 0 AND chokyo_den_oikiri_awase LIKE '%先着%', 'はい', NULL) AS shirushi_awase_senchaku_flag,
      CASE
        WHEN yosou_tansho_ninkijun_num BETWEEN 1 AND 3 THEN '1～3'
        WHEN yosou_tansho_ninkijun_num BETWEEN 4 AND 6 THEN '4～6'
        WHEN yosou_tansho_ninkijun_num >= 7 OR yosou_tansho_odds_float >= 50.0 THEN '7以上'
        ELSE NULL
      END AS shirushi_kubun_yosou_tansho_ninkijun,
      RANK() OVER (
        PARTITION BY race_code_kol,
        CASE
          WHEN yosou_tansho_ninkijun_num BETWEEN 1 AND 3 THEN '1～3'
          WHEN yosou_tansho_ninkijun_num BETWEEN 4 AND 6 THEN '4～6'
          WHEN yosou_tansho_ninkijun_num >= 7 OR yosou_tansho_odds_float >= 50.0 THEN '7以上'
        ELSE NULL
        END
        ORDER BY shirushi_point DESC, yosou_tansho_ninkijun_num ASC
      ) AS shirushi_kubun_rank
    FROM shirushi_points
  ),

  shirushi_final AS (
    SELECT
      *,
      CASE
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '1～3' AND shirushi_kubun_rank = 1 THEN '◎'
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '4～6' AND shirushi_kubun_rank = 1 THEN '○'
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '4～6' AND shirushi_kubun_rank = 2 THEN '▲'
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '1～3' AND shirushi_kubun_rank = 2 THEN '△'
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '7以上' AND shirushi_kubun_rank = 1 THEN '★'
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '7以上' AND shirushi_kubun_rank = 2 THEN '×'
        ELSE NULL
      END AS shirushi_shirushi_label,
      CASE
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '1～3' AND shirushi_kubun_rank = 1 THEN 1
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '4～6' AND shirushi_kubun_rank = 1 THEN 2
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '4～6' AND shirushi_kubun_rank = 2 THEN 3
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '1～3' AND shirushi_kubun_rank = 2 THEN 4
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '7以上' AND shirushi_kubun_rank = 1 THEN 5
        WHEN shirushi_kubun_yosou_tansho_ninkijun = '7以上' AND shirushi_kubun_rank = 2 THEN 6
        ELSE NULL
      END AS shirushi_shirushi_num
    FROM shirushi_calc
  )

-- Final Step: 全ての情報を結合し、最終的なカラムを生成
SELECT
  -- ID / コード
  z.race_code_uma_kol,
  z.kaisai_nengappi || z.keibajo_code_jvd_from_kol || z.kaisai_kaiji || z.kaisai_nichiji || z.race_num || z.umaban AS race_code_uma_jvd,
  z.race_code_kol,
  z.kaisai_nengappi || z.keibajo_code_jvd_from_kol || z.kaisai_kaiji || z.kaisai_nichiji || z.race_num AS race_code_jvd,
  z.keibajo_code_jvd_from_kol AS keibajo_code_jvd,
  z.keibajo_code AS keibajo_code_kol,
  z.hasso_date,
  z.kaisai_kaiji AS kaiji,
  z.kaisai_kaiji AS nichiji, -- (注: 元のSQL通り kaiji を nichiji にも割り当て)
  z.wakuban,
  z.race_num AS race_bango,
  SAFE_CAST(z.race_num AS INT64) AS race_bango_num,
  z.umaban,
  SAFE_CAST(z.umaban AS INT64) AS umaban_num,
  z.bamei,
  z.rating,
  SAFE_CAST(z.rating AS FLOAT64) / 10 AS rating_float,
  z.seibetsu_code,
  CASE z.seibetsu_code
    WHEN '0' THEN '牡'
    WHEN '1' THEN '牝'
    WHEN '2' THEN 'せん'
    ELSE NULL
  END AS seibetsu_code_label,
  z.barei,
  SAFE_CAST(z.barei AS INT64) AS barei_num,
  z.futan_juryo,
  SAFE_CAST(z.futan_juryo AS FLOAT64) / 10 AS futan_juryo_float,
  z.blinker_shiyo_kubun,
  CASE
    WHEN z.blinker_shiyo_kubun = '1' THEN 'はい'
    ELSE 'いいえ'
  END AS blinker_shiyo_kubun_label,
  z.kyuyo_riyu,
  z.banushimei,
  z.banushimei_ryakusho,
  z.ketto_toroku_bango AS ketto_toroku_bango_kol,
  z.ketto1_f_hanshoku_toroku_bango,
  z.ketto1_f_bamei,
  z.ketto2_m_hanshoku_toroku_bango,
  z.ketto2_m_bamei,
  z.ketto5_mf_hanshoku_toroku_bango,
  z.ketto5_mf_bamei,
  z.kishu_code,
  z.kishumei,
  z.kishumei_ryakusho,
  z.kishu_tozai_shozoku_code,
  CASE z.kishu_tozai_shozoku_code
    WHEN '1' THEN '西'
    WHEN '2' THEN '東'
    WHEN '3' THEN '招待'
    ELSE NULL
  END AS kishu_tozai_shozoku_code_label,
  z.kishu_minarai_code,
  CASE z.kishu_minarai_code
    WHEN '1' THEN '1kg減'
    WHEN '2' THEN '2kg減'
    WHEN '3' THEN '3kg減'
    WHEN '4' THEN '4kg減'
    WHEN '5' THEN '女性2kg減'
    ELSE NULL
  END AS kishu_minarai_code_label,
  z.kishu_shozokubasho_code,
  CASE z.kishu_shozokubasho_code
    WHEN '001' THEN '栗東'
    WHEN '002' THEN '美浦南'
    WHEN '003' THEN '美浦北'
    ELSE NULL
  END AS kishu_shozokubasho_code_label,
  z.kishu_shozoku_chokyoshi_code,
  z.kishu_norikawari_kubun,
  CASE
    WHEN z.kishu_norikawari_kubun = '1' THEN 'はい'
    ELSE 'いいえ'
  END AS kishu_norikawari_kubun_label,
  z.chokyoshi_code,
  z.chokyoshimei,
  z.chokyoshimei_ryakusho,
  z.chokyoshi_shozokubasho_code,
  CASE z.chokyoshi_shozokubasho_code
    WHEN '001' THEN '栗東'
    WHEN '002' THEN '美浦南'
    WHEN '003' THEN '美浦北'
    ELSE NULL
  END AS chokyoshi_shozokubasho_code_label,
  z.chokyoshi_tracen_kubun,
  CASE z.chokyoshi_tracen_kubun
    WHEN '1' THEN '栗東'
    WHEN '2' THEN '美浦南'
    WHEN '3' THEN '美浦北'
    ELSE NULL
  END AS chokyoshi_tracen_kubun_label,
  z.chokyo_den_oikiri_flag,
  CASE
    WHEN z.chokyo_den_oikiri_flag = '1' THEN 'はい'
    ELSE 'いいえ'
  END AS chokyo_den_oikiri_flag_label,
  z.chokyo_den_oikiri_kijosha,
  z.chokyo_den_oikiri_nengappi,
  SAFE.PARSE_DATE('%Y%m%d', z.chokyo_den_oikiri_nengappi) AS chokyo_den_oikiri_nengappi_date,
  z.chokyo_den_oikiri_basho,
  z.chokyo_den_oikiri_course,
  CASE
    WHEN z.chokyo_den_oikiri_course = '坂' THEN '坂路'
    WHEN z.chokyo_den_oikiri_course = 'Ｐ' OR z.chokyo_den_oikiri_course = 'P' THEN 'ポリトラック'
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN 'プール'
    ELSE 'コース'
  END AS chokyo_den_oikiri_course_kubun,
  COALESCE(z.chokyo_den_oikiri_basho, '') || COALESCE(z.chokyo_den_oikiri_course, '') AS chokyo_den_oikiri_basho_course_label,
  z.chokyo_den_oikiri_babajotai,

  -- 調教タイム関連フィールド (chokyo_den_oikiri_course の略語 '坂', 'P' を使用)
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN SAFE_CAST(REGEXP_REPLACE(z.chokyo_den_oikiri_6f_d2, r'[^0-9]', '') AS INT64)
    ELSE NULL
  END AS chokyo_den_oikiri_hanro_pool_kaisu_int,

  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE z.chokyo_den_oikiri_8f_d2
  END AS chokyo_den_oikiri_8f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_oikiri_8f_d2 AS FLOAT64)
  END AS chokyo_den_oikiri_8f_float,

  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE z.chokyo_den_oikiri_7f_d2
  END AS chokyo_den_oikiri_7f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_oikiri_7f_d2 AS FLOAT64)
  END AS chokyo_den_oikiri_7f_float,

  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE z.chokyo_den_oikiri_6f_d2
  END AS chokyo_den_oikiri_6f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_oikiri_6f_d2 AS FLOAT64)
  END AS chokyo_den_oikiri_6f_float,

  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE z.chokyo_den_oikiri_5f_d2
  END AS chokyo_den_oikiri_5f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64)
  END AS chokyo_den_oikiri_5f_float,

  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
    WHEN z.chokyo_den_oikiri_course = '坂' THEN z.chokyo_den_oikiri_5f_d2 -- 坂路は5Fを4Fとして使用
    ELSE z.chokyo_den_oikiri_4f_d2
  END AS chokyo_den_oikiri_4f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
    WHEN z.chokyo_den_oikiri_course = '坂' THEN SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64)
    ELSE SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64)
  END AS chokyo_den_oikiri_4f_float,

  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
    WHEN z.chokyo_den_oikiri_course = '坂' THEN z.chokyo_den_oikiri_4f_d2 -- 坂路は4Fを3Fとして使用
    ELSE z.chokyo_den_oikiri_3f_d2
  END AS chokyo_den_oikiri_3f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
    WHEN z.chokyo_den_oikiri_course = '坂' THEN SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64)
    ELSE SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64)
  END AS chokyo_den_oikiri_3f_float,

  ROUND(
    CASE
      WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
      WHEN z.chokyo_den_oikiri_course = '坂' THEN SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) -- 坂路は3Fを使用(実質2F)
      -- それ以外の場合: 3F - (4F - 3F)
      ELSE SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - (SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64))
    END, 1
  ) AS chokyo_den_oikiri_2f_float,

  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_oikiri_1f_d2
  END AS chokyo_den_oikiri_1f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64)
  END AS chokyo_den_oikiri_1f_float,

  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE ROUND(SAFE_CAST(z.chokyo_den_oikiri_8f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_7f_d2 AS FLOAT64), 1)
  END AS chokyo_den_oikiri_lap_8f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE ROUND(SAFE_CAST(z.chokyo_den_oikiri_7f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_6f_d2 AS FLOAT64), 1)
  END AS chokyo_den_oikiri_lap_7f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE ROUND(SAFE_CAST(z.chokyo_den_oikiri_6f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64), 1)
  END AS chokyo_den_oikiri_lap_6f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' OR z.chokyo_den_oikiri_course = '坂' THEN NULL
    ELSE ROUND(SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64), 1)
  END AS chokyo_den_oikiri_lap_5f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
    WHEN z.chokyo_den_oikiri_course = '坂' THEN ROUND(SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64), 1)
    ELSE ROUND(SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64), 1)
  END AS chokyo_den_oikiri_lap_4f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
    WHEN z.chokyo_den_oikiri_course = '坂' THEN ROUND(SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64), 1)
    ELSE
      -- 3F - 2F(推定)
      ROUND(SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - (
        SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64)
      ), 1)
  END AS chokyo_den_oikiri_lap_3f,
  CASE
    WHEN z.chokyo_den_oikiri_basho = 'プール' THEN NULL
    WHEN z.chokyo_den_oikiri_course = '坂' THEN ROUND(SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 1)
    ELSE
      -- 2F(推定) - 1F
      ROUND(
        (SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - (SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64)))
        - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 1)
  END AS chokyo_den_oikiri_lap_2f,

  CASE
    WHEN z.chokyo_den_oikiri_course = '坂' AND (z.chokyo_den_oikiri_basho LIKE '%栗東%' OR z.chokyo_den_oikiri_basho LIKE '%美南%') THEN
      CASE
        -- C3: 2F1F同タイム (< 12.0)
        WHEN ROUND(SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 1) = ROUND((SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64)), 1)
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) < 12.0
        THEN 'C3:2F1F同タイム'

        -- C2: 2F1F同タイム (12.0 <= 1F < 12.5)
        WHEN ROUND(SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 1) = ROUND((SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64)), 1)
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 12.0
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) < 12.5
        THEN 'C2:2F1F同タイム'

        -- C1: 2F1F同タイム (12.5 <= 1F < 13.0)
        WHEN ROUND(SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 1) = ROUND((SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64)), 1)
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 12.5
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) < 13.0
        THEN 'C1:2F1F同タイム'

        -- A3: 終い1F 11秒台の加速ラップ
        -- 1F < 12.0 AND 1F < 2F_Lap
        WHEN SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) < 12.0
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) < (SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64))
        THEN 'A3:終い1F11秒台の加速ラップ'

        -- B3: 2F 11秒台減速ラップ
        -- 2F_Lap < 12.0 AND 1F > 2F_Lap
        WHEN (SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64)) < 12.0
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) > (SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64))
        THEN 'B3:2F11秒台減速ラップ'

        -- A2: 終い2F各12秒台の加速ラップ
        -- 12.0 <= 1F < 13.0 AND 12.0 <= 2F_Lap < 13.0 AND 1F < 2F_Lap
        WHEN (SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 12.0 AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) < 13.0)
             AND (ROUND(SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 9) >= 12.0 AND ROUND(SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 9) < 13.0)
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) < ROUND(SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 9)
        THEN 'A2:終い2F各12秒台の加速ラップ'

        -- B2: 終い2F各12秒台の減速ラップ
        -- 12.0 <= 1F < 13.0 AND 12.0 <= 2F_Lap < 13.0 AND 1F > 2F_Lap
        WHEN (SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 12.0 AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) < 13.0)
             AND (ROUND(SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 9) >= 12.0 AND ROUND(SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 9) < 13.0)
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) > ROUND(SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 9)
        THEN 'B2:終い2F各12秒台の減速ラップ'

        -- A1: 終い1Fのみ12秒台の加速ラップ (1F < 2F_Lap)
        -- 12.0 <= 1F < 13.0 AND 2F_Lap >= 13.0
        WHEN (SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 12.0 AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) < 13.0)
             AND ROUND(SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64), 9) >= 13.0
        THEN 'A1:終い1Fのみ12秒台の加速ラップ'

        -- B1: 2Fのみ12秒台の減速ラップ (1Fは13.0以上)
        -- 12.0 <= 2F_Lap < 13.0 AND 1F >= 13.0
        WHEN ((SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64)) >= 12.0 AND (SAFE_CAST(z.chokyo_den_oikiri_3f_d2 AS FLOAT64) - SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64)) < 13.0)
             AND SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 13.0
        THEN 'B1:2Fのみ12秒台の減速ラップ'

        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_den_oikiri_lap_group,

  CASE
    WHEN (z.chokyo_den_oikiri_basho = '栗東' AND z.chokyo_den_oikiri_course = 'CW') OR (z.chokyo_den_oikiri_basho = '美南' AND z.chokyo_den_oikiri_course = 'Ｗ') THEN
      CASE
        WHEN SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) >= 70.0 THEN '70.0～'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) >= 68.0 THEN '68.0～69.9'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) >= 66.0 THEN '66.0～67.9'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) >= 64.0 THEN '64.0～65.9'
        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_den_oikiri_5f_wood_kubun,

  CASE
    WHEN (z.chokyo_den_oikiri_basho = '栗東' AND z.chokyo_den_oikiri_course = 'CW') OR (z.chokyo_den_oikiri_basho = '美南' AND z.chokyo_den_oikiri_course = 'Ｗ') THEN
      CASE
        WHEN SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64) >= 56.0 THEN '56.0～'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64) >= 54.0 THEN '54.0～55.9'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64) >= 52.0 THEN '52.0～53.9'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_4f_d2 AS FLOAT64) >= 50.0 THEN '50.0～51.9'
        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_den_oikiri_4f_wood_kubun,

  CASE
    WHEN (z.chokyo_den_oikiri_basho = '栗東' AND z.chokyo_den_oikiri_course = 'CW') OR (z.chokyo_den_oikiri_basho = '美南' AND z.chokyo_den_oikiri_course = 'Ｗ') THEN
      CASE
        WHEN SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 12.5 THEN '12.5～'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 12.0 THEN '12.0～12.4'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 11.5 THEN '11.5～11.9'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_1f_d2 AS FLOAT64) >= 11.0 THEN '11.0～11.4'
        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_den_oikiri_1f_wood_kubun,

  CASE
    WHEN (z.chokyo_den_oikiri_basho = '栗東' OR z.chokyo_den_oikiri_basho = '美南') AND z.chokyo_den_oikiri_course = '坂' THEN
      CASE
        WHEN SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) >= 56.0 AND SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) <= 57.9 THEN '56.0～57.9'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) >= 54.0 AND SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) <= 55.9 THEN '54.0～55.9'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) >= 52.0 AND SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) <= 53.9 THEN '52.0～53.9'
        WHEN SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) >= 50.0 AND SAFE_CAST(z.chokyo_den_oikiri_5f_d2 AS FLOAT64) <= 51.9 THEN '50.0～51.9'
        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_den_oikiri_4f_hanro_kubun,

  z.chokyo_den_oikiri_ichidori,
  CASE z.chokyo_den_oikiri_ichidori
     WHEN '1' THEN '①' WHEN '2' THEN '②' WHEN '3' THEN '③' WHEN '4' THEN '④' WHEN '5' THEN '⑤'
     WHEN '6' THEN '⑥' WHEN '7' THEN '⑦' WHEN '8' THEN '⑧' WHEN '9' THEN '⑨'
     ELSE z.chokyo_den_oikiri_ichidori
  END AS chokyo_den_oikiri_ichidori_label,

  z.chokyo_den_oikiri_ashiiro,
  CASE z.chokyo_den_oikiri_ashiiro
    WHEN '馬なり' THEN '馬なり'
    WHEN '馬ナリ' THEN '馬なり'
    WHEN '一 杯' THEN '一杯'
    WHEN '一杯' THEN '一杯'
    WHEN '強 め' THEN '強め'
    WHEN '強め' THEN '強め'
    WHEN '強目' THEN '強め'
    WHEN '末強め' THEN '末強め'
    WHEN '末強目' THEN '末強め'
    WHEN '直強め' THEN '直強め'
    WHEN '直強目' THEN '直強め'
    WHEN '叩一杯' THEN '叩一杯'
    WHEN '稍一杯' THEN '稍一杯'
    WHEN '末一杯' THEN '末一杯'
    WHEN '直一杯' THEN '直一杯'
    WHEN 'バテる' THEN 'バテる'
    WHEN '不明' THEN '不明'
    WHEN '不　明' THEN '不明'
    WHEN '不 明' THEN '不明'
    WHEN 'Ｇ前追' THEN 'G前追'
    WHEN '楽 走' THEN '楽走'
    WHEN '向正面' THEN '向正面'
    WHEN 'ササる' THEN 'ササる'
    WHEN '稍強め' THEN '稍強め'
    WHEN '止める' THEN '止める'
    WHEN 'バカ付' THEN 'バカ付'
    WHEN '引掛る' THEN '引掛る'
    WHEN '末抑え' THEN '末抑え'
    WHEN '直抑え' THEN '直抑え'
    WHEN '外逃げ' THEN '外逃げ'
    WHEN 'ヨレる' THEN 'ヨレる'
    ELSE z.chokyo_den_oikiri_ashiiro
  END AS chokyo_den_oikiri_ashiiro_label,
  z.chokyo_den_oikiri_yajirushi,
  CASE z.chokyo_den_oikiri_yajirushi
    WHEN '1' THEN '一変(↑)'
    WHEN '2' THEN '平行(→)'
    WHEN '3' THEN '下降(↓)'
    WHEN '4' THEN '良化(／)'
    WHEN '5' THEN '下降気味(＼)'
    ELSE NULL
  END AS chokyo_den_oikiri_yajirushi_label,
  z.chokyo_den_oikiri_reigai,

  CASE
     WHEN z.chokyo_den_oikiri_awase IS NOT NULL AND z.chokyo_den_oikiri_awase != ''
          AND z.chokyo_den_oikiri_ichidori IN ('6','7','8','9')
          AND z.chokyo_den_oikiri_awase LIKE '%先着%'
     THEN 'はい'
     ELSE NULL
  END AS chokyo_den_ichidori_furi_win_flag,

  z.chokyo_den_oikiri_awase AS chokyo_den_awase,
  z.chokyo_den_oikiri_awase_uma_bamei AS chokyo_den_awase_uma_bamei,
  pl.race_code_uma_kol_partner AS chokyo_den_awase_uma_race_code_uma_kol,
  pl.race_code_kol_partner AS chokyo_den_awase_uma_race_code_kol,
  pl.kyoso_joken_kubun_label AS chokyo_den_awase_uma_class,

  CASE
    WHEN pl.kyoso_joken_rank_int > z.kyoso_joken_rank_int THEN '格上'
    WHEN pl.kyoso_joken_rank_int < z.kyoso_joken_rank_int THEN '格下'
    WHEN pl.kyoso_joken_rank_int = z.kyoso_joken_rank_int AND z.kyoso_joken_rank_int > 0 THEN '同格'
    ELSE NULL
  END AS chokyo_den_awase_uma_kaku_kubun,

  CASE
    WHEN pl.kyoso_joken_rank_int > z.kyoso_joken_rank_int AND z.chokyo_den_oikiri_awase LIKE '%先着%' THEN 'はい'
    ELSE NULL
  END AS chokyo_den_awase_uma_kakuue_win_flag,

  REGEXP_EXTRACT(z.chokyo_den_oikiri_awase, r'([\d\.]+)秒') AS chokyo_den_awase_time_sa_float,

  CASE
    WHEN z.chokyo_den_oikiri_awase LIKE '%同入%' THEN '併せ同入'
    WHEN z.chokyo_den_oikiri_awase LIKE '%遅れ%' THEN '併せ遅れ'
    WHEN z.chokyo_den_oikiri_awase LIKE '%先着%' THEN '併せ先着'
    WHEN z.chokyo_den_oikiri_awase LIKE '%単走%' THEN '単走'
    ELSE NULL
  END AS chokyo_den_awase_kubun,

  z.chokyo_den_oikiri_awase_flag AS chokyo_den_awase_flag,
  CASE
     WHEN z.chokyo_den_oikiri_awase_flag = '2' THEN '調教2の併せ'
     WHEN z.chokyo_den_oikiri_awase_flag = '3' THEN '調教3の併せ'
     ELSE NULL
  END AS chokyo_den_awase_flag_label,

  z.chokyo_den_oikiri_tanpyo AS chokyo_den_tanpyo,

  z.chokyo_den_oikiri_honsu_course AS chokyo_den_honsu_course,
  SAFE_CAST(z.chokyo_den_oikiri_honsu_course AS INT64) AS chokyo_den_honsu_course_num,
  z.chokyo_den_oikiri_honsu_hanro AS chokyo_den_honsu_hanro,
  SAFE_CAST(z.chokyo_den_oikiri_honsu_hanro AS INT64) AS chokyo_den_honsu_hanro_num,
  z.chokyo_den_oikiri_honsu_pool AS chokyo_den_honsu_pool,
  SAFE_CAST(z.chokyo_den_oikiri_honsu_pool AS INT64) AS chokyo_den_honsu_pool_num,

  -- 調教 (sei2由来) -------------------------------------------------------------
  z.chokyo_sei_flag,
  CASE
    WHEN z.chokyo_sei_flag = '1' THEN 'はい'
    ELSE 'いいえ'
  END AS chokyo_sei_flag_label,
  z.chokyo_sei_kijosha,
  CASE
    WHEN z.chokyo_sei_kijosha IS NULL THEN NULL
    WHEN z.chokyo_sei_kijosha = '助手' THEN '助手'
    WHEN z.chokyo_sei_kijosha = '調教師' THEN '調教師'
    WHEN z.chokyo_sei_kijosha = '見習' THEN '見習'
    WHEN z.chokyo_sei_kijosha = '厩舎' THEN '厩舎'
    ELSE '騎手'
  END AS chokyo_sei_kijosha_kubun,
  CASE
    WHEN TRIM(z.chokyo_sei_kijosha) = TRIM(z.kishumei_ryakusho) THEN 'はい'
    ELSE 'いいえ'
  END AS chokyo_sei_kijosha_equal_kishumei_flag,
  z.chokyo_sei_nengappi,
  FORMAT_DATE('%Y年%m月%d日', SAFE.PARSE_DATE('%Y%m%d', z.chokyo_sei_nengappi)) || '(' || CASE EXTRACT(DAYOFWEEK FROM SAFE.PARSE_DATE('%Y%m%d', z.chokyo_sei_nengappi)) WHEN 1 THEN '日' WHEN 2 THEN '月' WHEN 3 THEN '火' WHEN 4 THEN '水' WHEN 5 THEN '木' WHEN 6 THEN '金' WHEN 7 THEN '土' END || ')' AS chokyo_sei_nengappi_label,
  DATE(DATETIME_ADD(PARSE_DATETIME('%Y%m%d', z.chokyo_sei_nengappi), INTERVAL 9 HOUR)) AS chokyo_sei_nengappi_date,
  z.chokyo_sei_basho,
  z.chokyo_sei_course,
  CASE
    WHEN z.chokyo_sei_course = '坂' THEN '坂路'
    WHEN z.chokyo_sei_course = 'Ｐ' OR z.chokyo_sei_course = 'P' THEN 'ポリトラック'
    WHEN z.chokyo_sei_basho = 'プール' THEN 'プール'
    ELSE 'コース'
  END AS chokyo_sei_course_kubun,
  COALESCE(z.chokyo_sei_basho, '') || COALESCE(z.chokyo_sei_course, '') AS chokyo_sei_basho_course_label,
  z.chokyo_sei_babajotai,

  -- 調教タイム関連フィールド (chokyo_sei_course の略語 '坂', 'P' を使用)
  CASE
    WHEN z.chokyo_sei_basho = 'プール' OR z.chokyo_sei_course = '坂' THEN SAFE_CAST(REGEXP_REPLACE(z.chokyo_sei_6f, r'[^0-9]', '') AS INT64)
    ELSE NULL
  END AS chokyo_sei_hanro_pool_kaisu_int,

  z.chokyo_sei_8f,
  SAFE_CAST(z.chokyo_sei_8f AS FLOAT64) AS chokyo_sei_8f_float,

  z.chokyo_sei_7f,
  SAFE_CAST(z.chokyo_sei_7f AS FLOAT64) AS chokyo_sei_7f_float,

  z.chokyo_sei_6f,
  SAFE_CAST(z.chokyo_sei_6f AS FLOAT64) AS chokyo_sei_6f_float,

  z.chokyo_sei_5f,
  SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) AS chokyo_sei_5f_float,

  CASE
    WHEN z.chokyo_sei_course = '坂' THEN z.chokyo_sei_5f -- 坂路は5Fを4Fとして使用
    ELSE z.chokyo_sei_4f
  END AS chokyo_sei_4f,
  CASE
    WHEN z.chokyo_sei_course = '坂' THEN SAFE_CAST(z.chokyo_sei_5f AS FLOAT64)
    ELSE SAFE_CAST(z.chokyo_sei_4f AS FLOAT64)
  END AS chokyo_sei_4f_float,

  CASE
    WHEN z.chokyo_sei_course = '坂' THEN z.chokyo_sei_4f -- 坂路は4Fを3Fとして使用
    ELSE z.chokyo_sei_3f
  END AS chokyo_sei_3f,
  CASE
    WHEN z.chokyo_sei_course = '坂' THEN SAFE_CAST(z.chokyo_sei_4f AS FLOAT64)
    ELSE SAFE_CAST(z.chokyo_sei_3f AS FLOAT64)
  END AS chokyo_sei_3f_float,

  ROUND(
    CASE
      WHEN z.chokyo_sei_basho = 'プール' THEN NULL
      WHEN z.chokyo_sei_course = '坂' THEN SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) -- 坂路は3Fを使用(実質2F)
      -- それ以外の場合: 3F - 1F
      ELSE SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64)
    END, 1
  ) AS chokyo_sei_2f_float,

  z.chokyo_sei_1f,
  SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) AS chokyo_sei_1f_float,

  CASE
    WHEN z.chokyo_sei_basho = 'プール' OR z.chokyo_sei_course = '坂' THEN NULL
    ELSE ROUND(SAFE_CAST(z.chokyo_sei_8f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_7f AS FLOAT64), 1)
  END AS chokyo_sei_lap_8f,
  CASE
    WHEN z.chokyo_sei_basho = 'プール' OR z.chokyo_sei_course = '坂' THEN NULL
    ELSE ROUND(SAFE_CAST(z.chokyo_sei_7f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_6f AS FLOAT64), 1)
  END AS chokyo_sei_lap_7f,
  CASE
    WHEN z.chokyo_sei_basho = 'プール' OR z.chokyo_sei_course = '坂' THEN NULL
    ELSE ROUND(SAFE_CAST(z.chokyo_sei_6f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_5f AS FLOAT64), 1)
  END AS chokyo_sei_lap_6f,
  CASE
    WHEN z.chokyo_sei_basho = 'プール' OR z.chokyo_sei_course = '坂' THEN NULL
    ELSE ROUND(SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_4f AS FLOAT64), 1)
  END AS chokyo_sei_lap_5f,
  CASE
    WHEN z.chokyo_sei_basho = 'プール' THEN NULL
    WHEN z.chokyo_sei_course = '坂' THEN ROUND(SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_4f AS FLOAT64), 1)
    ELSE ROUND(SAFE_CAST(z.chokyo_sei_4f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_3f AS FLOAT64), 1)
  END AS chokyo_sei_lap_4f,
  CASE
    WHEN z.chokyo_sei_basho = 'プール' THEN NULL
    WHEN z.chokyo_sei_course = '坂' THEN ROUND(SAFE_CAST(z.chokyo_sei_4f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_3f AS FLOAT64), 1)
    ELSE
      -- 3F - 2F(推定)
      ROUND(SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - (
        SAFE_CAST(z.chokyo_sei_4f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_3f AS FLOAT64)
      ), 1)
  END AS chokyo_sei_lap_3f,
  CASE
    WHEN z.chokyo_sei_basho = 'プール' THEN NULL
    WHEN z.chokyo_sei_course = '坂' THEN ROUND(SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 1)
    ELSE
      -- 2F(推定) - 1F
      ROUND(
        (SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - (SAFE_CAST(z.chokyo_sei_4f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_3f AS FLOAT64)))
        - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 1)
  END AS chokyo_sei_lap_2f,

  CASE
    WHEN z.chokyo_sei_course = '坂' AND (z.chokyo_sei_basho LIKE '%栗東%' OR z.chokyo_sei_basho LIKE '%美南%') THEN
      CASE
        -- C3: 2F1F同タイム (< 12.0)
        WHEN ROUND(SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 1) = ROUND((SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64)), 1)
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) < 12.0
        THEN 'C3:2F1F同タイム'

        -- C2: 2F1F同タイム (12.0 <= 1F < 12.5)
        WHEN ROUND(SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 1) = ROUND((SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64)), 1)
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 12.0
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) < 12.5
        THEN 'C2:2F1F同タイム'

        -- C1: 2F1F同タイム (12.5 <= 1F < 13.0)
        WHEN ROUND(SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 1) = ROUND((SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64)), 1)
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 12.5
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) < 13.0
        THEN 'C1:2F1F同タイム'

        -- A3: 終い1F 11秒台の加速ラップ
        WHEN SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) < 12.0
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) < (SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64))
        THEN 'A3:終い1F11秒台の加速ラップ'

        -- B3: 2F 11秒台減速ラップ
        WHEN (SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64)) < 12.0
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) > (SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64))
        THEN 'B3:2F11秒台減速ラップ'

        -- A2: 終い2F各12秒台の加速ラップ
        -- 12.0 <= 1F < 13.0 AND 12.0 <= 2F_Lap < 13.0 AND 1F < 2F_Lap
        WHEN (SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 12.0 AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) < 13.0)
             AND (ROUND(SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 9) >= 12.0 AND ROUND(SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 9) < 13.0)
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) < ROUND(SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 9)
        THEN 'A2:終い2F各12秒台の加速ラップ'

        -- B2: 終い2F各12秒台の減速ラップ
        -- 12.0 <= 1F < 13.0 AND 12.0 <= 2F_Lap < 13.0 AND 1F > 2F_Lap
        WHEN (SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 12.0 AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) < 13.0)
             AND (ROUND(SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 9) >= 12.0 AND ROUND(SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 9) < 13.0)
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) > ROUND(SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 9)
        THEN 'B2:終い2F各12秒台の減速ラップ'

        -- A1: 終い1Fのみ12秒台の加速ラップ (1F < 2F_Lap)
        -- 12.0 <= 1F < 13.0 AND 2F_Lap >= 13.0
        WHEN (SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 12.0 AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) < 13.0)
             AND ROUND(SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64), 9) >= 13.0
        THEN 'A1:終い1Fのみ12秒台の加速ラップ'

        -- B1: 2Fのみ12秒台の減速ラップ
        -- 12.0 <= 2F_Lap < 13.0 AND 1F >= 13.0
        WHEN ((SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64)) >= 12.0 AND (SAFE_CAST(z.chokyo_sei_3f AS FLOAT64) - SAFE_CAST(z.chokyo_sei_1f AS FLOAT64)) < 13.0)
             AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 13.0
        THEN 'B1:2Fのみ12秒台の減速ラップ'

        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_sei_lap_group,

  CASE
    WHEN z.chokyo_sei_basho = '栗東' AND z.chokyo_sei_course = '坂' AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) <= 12.4 THEN 'はい'
    WHEN z.chokyo_sei_basho = '美南' AND z.chokyo_sei_course = '坂' AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) <= 12.5 THEN 'はい'
    WHEN z.chokyo_sei_basho = '栗東' AND z.chokyo_sei_course = 'CW' AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) <= 11.6 THEN 'はい'
    WHEN z.chokyo_sei_basho = '美南' AND z.chokyo_sei_course = 'Ｗ' AND SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) <= 11.7 THEN 'はい'
    ELSE NULL
  END AS chokyo_sei_check_time_1f_flag,

  CASE
    WHEN z.chokyo_sei_basho = '栗東' AND z.chokyo_sei_course = '坂' AND SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) <= 53.9 THEN 'はい'
    WHEN z.chokyo_sei_basho = '美南' AND z.chokyo_sei_course = '坂' AND SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) <= 54.9 THEN 'はい'
    WHEN z.chokyo_sei_basho = '栗東' AND z.chokyo_sei_course = 'CW' AND SAFE_CAST(z.chokyo_sei_6f AS FLOAT64) <= 82.9 THEN 'はい'
    WHEN z.chokyo_sei_basho = '美南' AND z.chokyo_sei_course = 'Ｗ' AND SAFE_CAST(z.chokyo_sei_6f AS FLOAT64) <= 83.9 THEN 'はい'
    ELSE NULL
  END AS chokyo_sei_check_time_4f_6f_flag,

  CASE
    WHEN (z.chokyo_sei_basho = '栗東' AND z.chokyo_sei_course = 'CW') OR (z.chokyo_sei_basho = '美南' AND z.chokyo_sei_course = 'Ｗ') THEN
      CASE
        WHEN SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) >= 70.0 THEN '70.0～'
        WHEN SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) >= 68.0 THEN '68.0～69.9'
        WHEN SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) >= 66.0 THEN '66.0～67.9'
        WHEN SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) >= 64.0 THEN '64.0～65.9'
        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_sei_5f_wood_kubun,

  CASE
    WHEN (z.chokyo_sei_basho = '栗東' AND z.chokyo_sei_course = 'CW') OR (z.chokyo_sei_basho = '美南' AND z.chokyo_sei_course = 'Ｗ') THEN
      CASE
        WHEN SAFE_CAST(z.chokyo_sei_4f AS FLOAT64) >= 56.0 THEN '56.0～'
        WHEN SAFE_CAST(z.chokyo_sei_4f AS FLOAT64) >= 54.0 THEN '54.0～55.9'
        WHEN SAFE_CAST(z.chokyo_sei_4f AS FLOAT64) >= 52.0 THEN '52.0～53.9'
        WHEN SAFE_CAST(z.chokyo_sei_4f AS FLOAT64) >= 50.0 THEN '50.0～51.9'
        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_sei_4f_wood_kubun,

  CASE
    WHEN (z.chokyo_sei_basho = '栗東' AND z.chokyo_sei_course = 'CW') OR (z.chokyo_sei_basho = '美南' AND z.chokyo_sei_course = 'Ｗ') THEN
      CASE
        WHEN SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 12.5 THEN '12.5～'
        WHEN SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 12.0 THEN '12.0～12.4'
        WHEN SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 11.5 THEN '11.5～11.9'
        WHEN SAFE_CAST(z.chokyo_sei_1f AS FLOAT64) >= 11.0 THEN '11.0～11.4'
        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_sei_1f_wood_kubun,

  CASE
    WHEN (z.chokyo_sei_basho = '栗東' OR z.chokyo_sei_basho = '美南') AND z.chokyo_sei_course = '坂' THEN
      CASE
        WHEN SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) >= 56.0 AND SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) <= 57.9 THEN '56.0～57.9'
        WHEN SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) >= 54.0 AND SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) <= 55.9 THEN '54.0～55.9'
        WHEN SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) >= 52.0 AND SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) <= 53.9 THEN '52.0～53.9'
        WHEN SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) >= 50.0 AND SAFE_CAST(z.chokyo_sei_5f AS FLOAT64) <= 51.9 THEN '50.0～51.9'
        ELSE NULL
      END
    ELSE NULL
  END AS chokyo_sei_4f_hanro_kubun,

  z.chokyo_sei_ichidori,
  CASE z.chokyo_sei_ichidori
     WHEN '1' THEN '①' WHEN '2' THEN '②' WHEN '3' THEN '③' WHEN '4' THEN '④' WHEN '5' THEN '⑤'
     WHEN '6' THEN '⑥' WHEN '7' THEN '⑦' WHEN '8' THEN '⑧' WHEN '9' THEN '⑨'
     ELSE z.chokyo_sei_ichidori
  END AS chokyo_sei_ichidori_label,

  z.chokyo_sei_ashiiro,
  CASE z.chokyo_sei_ashiiro
    WHEN '馬なり' THEN '馬なり' WHEN '馬ナリ' THEN '馬なり' WHEN '一 杯' THEN '一杯' WHEN '一杯' THEN '一杯'
    WHEN '強 め' THEN '強め' WHEN '強め' THEN '強め' WHEN '強目' THEN '強め' WHEN '末強め' THEN '末強め'
    WHEN '末強目' THEN '末強め' WHEN '直強め' THEN '直強め' WHEN '直強目' THEN '直強め' WHEN '叩一杯' THEN '叩一杯'
    WHEN '稍一杯' THEN '稍一杯' WHEN '末一杯' THEN '末一杯' WHEN '直一杯' THEN '直一杯' WHEN 'バテる' THEN 'バテる'
    WHEN '不明' THEN '不明' WHEN '不　明' THEN '不明' WHEN '不 明' THEN '不明' WHEN 'Ｇ前追' THEN 'G前追'
    WHEN '楽 走' THEN '楽走' WHEN '向正面' THEN '向正面' WHEN 'ササる' THEN 'ササる' WHEN '稍強め' THEN '稍強め'
    WHEN '止める' THEN '止める' WHEN 'バカ付' THEN 'バカ付' WHEN '引掛る' THEN '引掛る' WHEN '末抑え' THEN '末抑え'
    WHEN '直抑え' THEN '直抑え' WHEN '外逃げ' THEN '外逃げ' WHEN 'ヨレる' THEN 'ヨレる'
    ELSE z.chokyo_sei_ashiiro
  END AS chokyo_sei_ashiiro_label,
  z.chokyo_sei_yajirushi,
  CASE z.chokyo_sei_yajirushi
    WHEN '1' THEN '一変(↑)' WHEN '2' THEN '平行(→)' WHEN '3' THEN '下降(↓)' WHEN '4' THEN '良化(／)' WHEN '5' THEN '下降気味(＼)'
    ELSE NULL
  END AS chokyo_sei_yajirushi_label,
  z.chokyo_sei_reigai,

  z.chokyo_den_chokyo1_flag,
  CASE WHEN z.chokyo_den_chokyo1_flag = '1' THEN 'はい' ELSE 'いいえ' END AS chokyo_den_chokyo1_flag_label,
  z.chokyo_den_chokyo1_kijosha,
  z.chokyo_den_chokyo1_nengappi,
  SAFE.PARSE_DATE('%Y%m%d', z.chokyo_den_chokyo1_nengappi) AS chokyo_den_chokyo1_nengappi_date,
  z.chokyo_den_chokyo1_basho,
  z.chokyo_den_chokyo1_course,
  CASE
    WHEN z.chokyo_den_chokyo1_course = '坂' THEN '坂路'
    WHEN z.chokyo_den_chokyo1_course = 'Ｐ' OR z.chokyo_den_chokyo1_course = 'P' THEN 'ポリトラック'
    WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN 'プール'
    ELSE 'コース'
  END AS chokyo_den_chokyo1_course_kubun,
  COALESCE(z.chokyo_den_chokyo1_basho, '') || COALESCE(z.chokyo_den_chokyo1_course, '') AS chokyo_den_chokyo1_basho_course_label,
  z.chokyo_den_chokyo1_babajotai,

  CASE
    WHEN z.chokyo_den_chokyo1_basho = 'プール' OR z.chokyo_den_chokyo1_course = '坂' THEN SAFE_CAST(REGEXP_REPLACE(z.chokyo_den_chokyo1_6f, r'[^0-9]', '') AS INT64)
    ELSE NULL
  END AS chokyo_den_chokyo1_hanro_pool_kaisu_int,

  CASE WHEN z.chokyo_den_chokyo1_basho = 'プール' OR z.chokyo_den_chokyo1_course = '坂' THEN NULL ELSE z.chokyo_den_chokyo1_8f END AS chokyo_den_chokyo1_8f,
  CASE WHEN z.chokyo_den_chokyo1_basho = 'プール' OR z.chokyo_den_chokyo1_course = '坂' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo1_8f AS FLOAT64) END AS chokyo_den_chokyo1_8f_float,

  CASE WHEN z.chokyo_den_chokyo1_basho = 'プール' OR z.chokyo_den_chokyo1_course = '坂' THEN NULL ELSE z.chokyo_den_chokyo1_7f END AS chokyo_den_chokyo1_7f,
  CASE WHEN z.chokyo_den_chokyo1_basho = 'プール' OR z.chokyo_den_chokyo1_course = '坂' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo1_7f AS FLOAT64) END AS chokyo_den_chokyo1_7f_float,

  CASE WHEN z.chokyo_den_chokyo1_basho = 'プール' OR z.chokyo_den_chokyo1_course = '坂' THEN NULL ELSE z.chokyo_den_chokyo1_6f END AS chokyo_den_chokyo1_6f,
  CASE WHEN z.chokyo_den_chokyo1_basho = 'プール' OR z.chokyo_den_chokyo1_course = '坂' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo1_6f AS FLOAT64) END AS chokyo_den_chokyo1_6f_float,

  CASE WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN NULL ELSE z.chokyo_den_chokyo1_5f END AS chokyo_den_chokyo1_5f,
  CASE WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo1_5f AS FLOAT64) END AS chokyo_den_chokyo1_5f_float,

  CASE
    WHEN z.chokyo_den_chokyo1_course = '坂' THEN z.chokyo_den_chokyo1_5f
    WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_chokyo1_4f
  END AS chokyo_den_chokyo1_4f,
  CASE
    WHEN z.chokyo_den_chokyo1_course = '坂' THEN SAFE_CAST(z.chokyo_den_chokyo1_5f AS FLOAT64)
    WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_chokyo1_4f AS FLOAT64)
  END AS chokyo_den_chokyo1_4f_float,

  CASE
    WHEN z.chokyo_den_chokyo1_course = '坂' THEN z.chokyo_den_chokyo1_4f
    WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_chokyo1_3f
  END AS chokyo_den_chokyo1_3f,
  CASE
    WHEN z.chokyo_den_chokyo1_course = '坂' THEN SAFE_CAST(z.chokyo_den_chokyo1_4f AS FLOAT64)
    WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_chokyo1_3f AS FLOAT64)
  END AS chokyo_den_chokyo1_3f_float,

  ROUND(
    CASE
      WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN NULL
      WHEN z.chokyo_den_chokyo1_course = '坂' THEN SAFE_CAST(z.chokyo_den_chokyo1_3f AS FLOAT64)
      ELSE SAFE_CAST(z.chokyo_den_chokyo1_3f AS FLOAT64) - (SAFE_CAST(z.chokyo_den_chokyo1_4f AS FLOAT64) - SAFE_CAST(z.chokyo_den_chokyo1_3f AS FLOAT64))
    END, 1
  ) AS chokyo_den_chokyo1_2f_float,

  CASE
    WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_chokyo1_1f
  END AS chokyo_den_chokyo1_1f,
  CASE WHEN z.chokyo_den_chokyo1_basho = 'プール' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo1_1f AS FLOAT64) END AS chokyo_den_chokyo1_1f_float,

  z.chokyo_den_chokyo1_ichidori,

  CASE z.chokyo_den_chokyo1_ichidori
     WHEN '1' THEN '①' WHEN '2' THEN '②' WHEN '3' THEN '③' WHEN '4' THEN '④' WHEN '5' THEN '⑤'
     WHEN '6' THEN '⑥' WHEN '7' THEN '⑦' WHEN '8' THEN '⑧' WHEN '9' THEN '⑨'
     ELSE z.chokyo_den_chokyo1_ichidori
  END AS chokyo_den_chokyo1_ichidori_label,

  z.chokyo_den_chokyo1_ashiiro,
  CASE z.chokyo_den_chokyo1_ashiiro
    WHEN '馬なり' THEN '馬なり' WHEN '馬ナリ' THEN '馬なり' WHEN '一 杯' THEN '一杯' WHEN '一杯' THEN '一杯'
    WHEN '強 め' THEN '強め' WHEN '強め' THEN '強め' WHEN '強目' THEN '強め' WHEN '末強め' THEN '末強め'
    WHEN '末強目' THEN '末強め' WHEN '直強め' THEN '直強め' WHEN '直強目' THEN '強め' WHEN '叩一杯' THEN '叩一杯'
    WHEN '稍一杯' THEN '稍一杯' WHEN '末一杯' THEN '末一杯' WHEN '直一杯' THEN '直一杯' WHEN 'バテる' THEN 'バテる'
    WHEN '不明' THEN '不明' WHEN '不　明' THEN '不明' WHEN '不 明' THEN '不明' WHEN 'Ｇ前追' THEN 'G前追'
    WHEN '楽 走' THEN '楽走' WHEN '向正面' THEN '向正面' WHEN 'ササる' THEN 'ササる' WHEN '稍強め' THEN '稍強め'
    WHEN '止める' THEN '止める' WHEN 'バカ付' THEN 'バカ付' WHEN '引掛る' THEN '引掛る' WHEN '末抑え' THEN '末抑え'
    WHEN '直抑え' THEN '直抑え' WHEN '外逃げ' THEN '外逃げ' WHEN 'ヨレる' THEN 'ヨレる'
    ELSE z.chokyo_den_chokyo1_ashiiro
  END AS chokyo_den_chokyo1_ashiiro_label,
  z.chokyo_den_chokyo1_yajirushi,
  CASE z.chokyo_den_chokyo1_yajirushi
    WHEN '1' THEN '一変(↑)' WHEN '2' THEN '平行(→)' WHEN '3' THEN '下降(↓)' WHEN '4' THEN '良化(／)' WHEN '5' THEN '下降気味(＼)'
    ELSE NULL
  END AS chokyo_den_chokyo1_yajirushi_label,
  z.chokyo_den_chokyo1_reigai,

  -- 調教2 Logic ----------------------------------------------------------------
  z.chokyo_den_chokyo2_flag AS chokyo_den_chokyo2_flag,
  CASE WHEN z.chokyo_den_chokyo2_flag = '1' THEN 'はい' ELSE 'いいえ' END AS chokyo_den_chokyo2_flag_label,
  z.chokyo_den_chokyo2_kijosha,
  z.chokyo_den_chokyo2_nengappi,
  SAFE.PARSE_DATE('%Y%m%d', z.chokyo_den_chokyo2_nengappi) AS chokyo_den_chokyo2_nengappi_date,
  z.chokyo_den_chokyo2_basho,
  z.chokyo_den_chokyo2_course,
  CASE
    WHEN z.chokyo_den_chokyo2_course = '坂' THEN '坂路'
    WHEN z.chokyo_den_chokyo2_course = 'Ｐ' OR z.chokyo_den_chokyo2_course = 'P' THEN 'ポリトラック'
    WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN 'プール'
    ELSE 'コース'
  END AS chokyo_den_chokyo2_course_kubun,
  COALESCE(z.chokyo_den_chokyo2_basho, '') || COALESCE(z.chokyo_den_chokyo2_course, '') AS chokyo_den_chokyo2_basho_course_label,
  z.chokyo_den_chokyo2_babajotai,

  CASE
    WHEN z.chokyo_den_chokyo2_basho = 'プール' OR z.chokyo_den_chokyo2_course = '坂' THEN SAFE_CAST(REGEXP_REPLACE(z.chokyo_den_chokyo2_6f, r'[^0-9]', '') AS INT64)
    ELSE NULL
  END AS chokyo_den_chokyo2_hanro_pool_kaisu_int,

  CASE WHEN z.chokyo_den_chokyo2_basho = 'プール' OR z.chokyo_den_chokyo2_course = '坂' THEN NULL ELSE z.chokyo_den_chokyo2_8f END AS chokyo_den_chokyo2_8f,
  CASE WHEN z.chokyo_den_chokyo2_basho = 'プール' OR z.chokyo_den_chokyo2_course = '坂' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo2_8f AS FLOAT64) END AS chokyo_den_chokyo2_8f_float,
  CASE WHEN z.chokyo_den_chokyo2_basho = 'プール' OR z.chokyo_den_chokyo2_course = '坂' THEN NULL ELSE z.chokyo_den_chokyo2_7f END AS chokyo_den_chokyo2_7f,
  CASE WHEN z.chokyo_den_chokyo2_basho = 'プール' OR z.chokyo_den_chokyo2_course = '坂' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo2_7f AS FLOAT64) END AS chokyo_den_chokyo2_7f_float,
  CASE WHEN z.chokyo_den_chokyo2_basho = 'プール' OR z.chokyo_den_chokyo2_course = '坂' THEN NULL ELSE z.chokyo_den_chokyo2_6f END AS chokyo_den_chokyo2_6f,
  CASE WHEN z.chokyo_den_chokyo2_basho = 'プール' OR z.chokyo_den_chokyo2_course = '坂' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo2_6f AS FLOAT64) END AS chokyo_den_chokyo2_6f_float,

  CASE WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN NULL ELSE z.chokyo_den_chokyo2_5f END AS chokyo_den_chokyo2_5f,
  CASE WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo2_5f AS FLOAT64) END AS chokyo_den_chokyo2_5f_float,
  CASE
    WHEN z.chokyo_den_chokyo2_course = '坂' THEN z.chokyo_den_chokyo2_5f
    WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_chokyo2_4f
  END AS chokyo_den_chokyo2_4f,
  CASE
    WHEN z.chokyo_den_chokyo2_course = '坂' THEN SAFE_CAST(z.chokyo_den_chokyo2_5f AS FLOAT64)
    WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_chokyo2_4f AS FLOAT64)
  END AS chokyo_den_chokyo2_4f_float,

  CASE
    WHEN z.chokyo_den_chokyo2_course = '坂' THEN z.chokyo_den_chokyo2_4f
    WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_chokyo2_3f
  END AS chokyo_den_chokyo2_3f,
  CASE
    WHEN z.chokyo_den_chokyo2_course = '坂' THEN SAFE_CAST(z.chokyo_den_chokyo2_4f AS FLOAT64)
    WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_chokyo2_3f AS FLOAT64)
  END AS chokyo_den_chokyo2_3f_float,

  ROUND(
    CASE
      WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN NULL
      WHEN z.chokyo_den_chokyo2_course = '坂' THEN SAFE_CAST(z.chokyo_den_chokyo2_3f AS FLOAT64)
      ELSE SAFE_CAST(z.chokyo_den_chokyo2_3f AS FLOAT64) - (SAFE_CAST(z.chokyo_den_chokyo2_4f AS FLOAT64) - SAFE_CAST(z.chokyo_den_chokyo2_3f AS FLOAT64))
    END, 1
  ) AS chokyo_den_chokyo2_2f_float,

  CASE
    WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_chokyo2_1f
  END AS chokyo_den_chokyo2_1f,
  CASE WHEN z.chokyo_den_chokyo2_basho = 'プール' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo2_1f AS FLOAT64) END AS chokyo_den_chokyo2_1f_float,

  z.chokyo_den_chokyo2_ichidori,

  CASE z.chokyo_den_chokyo2_ichidori
     WHEN '1' THEN '①' WHEN '2' THEN '②' WHEN '3' THEN '③' WHEN '4' THEN '④' WHEN '5' THEN '⑤'
     WHEN '6' THEN '⑥' WHEN '7' THEN '⑦' WHEN '8' THEN '⑧' WHEN '9' THEN '⑨'
     ELSE z.chokyo_den_chokyo2_ichidori
  END AS chokyo_den_chokyo2_ichidori_label,

  z.chokyo_den_chokyo2_ashiiro,
  CASE z.chokyo_den_chokyo2_ashiiro
    WHEN '馬なり' THEN '馬なり' WHEN '馬ナリ' THEN '馬なり' WHEN '一 杯' THEN '一杯' WHEN '一杯' THEN '一杯'
    WHEN '強 め' THEN '強め' WHEN '強め' THEN '強め' WHEN '強目' THEN '強め' WHEN '末強め' THEN '末強め'
    WHEN '末強目' THEN '末強め' WHEN '直強め' THEN '直強め' WHEN '直強目' THEN '直強め' WHEN '叩一杯' THEN '叩一杯'
    WHEN '稍一杯' THEN '稍一杯' WHEN '末一杯' THEN '末一杯' WHEN '直一杯' THEN '直一杯' WHEN 'バテる' THEN 'バテる'
    WHEN '不明' THEN '不明' WHEN '不　明' THEN '不明' WHEN '不 明' THEN '不明' WHEN 'Ｇ前追' THEN 'G前追'
    WHEN '楽 走' THEN '楽走' WHEN '向正面' THEN '向正面' WHEN 'ササる' THEN 'ササる' WHEN '稍強め' THEN '稍強め'
    WHEN '止める' THEN '止める' WHEN 'バカ付' THEN 'バカ付' WHEN '引掛る' THEN '引掛る' WHEN '末抑え' THEN '末抑え'
    WHEN '直抑え' THEN '直抑え' WHEN '外逃げ' THEN '外逃げ' WHEN 'ヨレる' THEN 'ヨレる'
    ELSE z.chokyo_den_chokyo2_ashiiro
  END AS chokyo_den_chokyo2_ashiiro_label,
  z.chokyo_den_chokyo2_yajirushi,
  CASE z.chokyo_den_chokyo2_yajirushi
    WHEN '1' THEN '一変(↑)' WHEN '2' THEN '平行(→)' WHEN '3' THEN '下降(↓)' WHEN '4' THEN '良化(／)' WHEN '5' THEN '下降気味(＼)'
    ELSE NULL
  END AS chokyo_den_chokyo2_yajirushi_label,
  z.chokyo_den_chokyo2_reigai,

   -- 調教3 Logic ----------------------------------------------------------------
  z.chokyo_den_chokyo3_flag AS chokyo_den_chokyo3_flag,
  CASE WHEN z.chokyo_den_chokyo3_flag = '1' THEN 'はい' ELSE 'いいえ' END AS chokyo_den_chokyo3_flag_label,
  z.chokyo_den_chokyo3_kijosha,
  z.chokyo_den_chokyo3_nengappi,
  SAFE.PARSE_DATE('%Y%m%d', z.chokyo_den_chokyo3_nengappi) AS chokyo_den_chokyo3_nengappi_date,
  z.chokyo_den_chokyo3_basho,
  z.chokyo_den_chokyo3_course,
  CASE
    WHEN z.chokyo_den_chokyo3_course = '坂' THEN '坂路'
    WHEN z.chokyo_den_chokyo3_course = 'Ｐ' OR z.chokyo_den_chokyo3_course = 'P' THEN 'ポリトラック'
    WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN 'プール'
    ELSE 'コース'
  END AS chokyo_den_chokyo3_course_kubun,
  COALESCE(z.chokyo_den_chokyo3_basho, '') || COALESCE(z.chokyo_den_chokyo3_course, '') AS chokyo_den_chokyo3_basho_course_label,
  z.chokyo_den_chokyo3_babajotai,

  CASE
    WHEN z.chokyo_den_chokyo3_basho = 'プール' OR z.chokyo_den_chokyo3_course = '坂' THEN SAFE_CAST(REGEXP_REPLACE(z.chokyo_den_chokyo3_6f, r'[^0-9]', '') AS INT64)
    ELSE NULL
  END AS chokyo_den_chokyo3_hanro_pool_kaisu_int,

  CASE WHEN z.chokyo_den_chokyo3_basho = 'プール' OR z.chokyo_den_chokyo3_course = '坂' THEN NULL ELSE z.chokyo_den_chokyo3_8f END AS chokyo_den_chokyo3_8f,
  CASE WHEN z.chokyo_den_chokyo3_basho = 'プール' OR z.chokyo_den_chokyo3_course = '坂' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo3_8f AS FLOAT64) END AS chokyo_den_chokyo3_8f_float,
  CASE WHEN z.chokyo_den_chokyo3_basho = 'プール' OR z.chokyo_den_chokyo3_course = '坂' THEN NULL ELSE z.chokyo_den_chokyo3_7f END AS chokyo_den_chokyo3_7f,
  CASE WHEN z.chokyo_den_chokyo3_basho = 'プール' OR z.chokyo_den_chokyo3_course = '坂' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo3_7f AS FLOAT64) END AS chokyo_den_chokyo3_7f_float,
  CASE WHEN z.chokyo_den_chokyo3_basho = 'プール' OR z.chokyo_den_chokyo3_course = '坂' THEN NULL ELSE z.chokyo_den_chokyo3_6f END AS chokyo_den_chokyo3_6f,
  CASE WHEN z.chokyo_den_chokyo3_basho = 'プール' OR z.chokyo_den_chokyo3_course = '坂' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo3_6f AS FLOAT64) END AS chokyo_den_chokyo3_6f_float,

  CASE WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN NULL ELSE z.chokyo_den_chokyo3_5f END AS chokyo_den_chokyo3_5f,
  CASE WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo3_5f AS FLOAT64) END AS chokyo_den_chokyo3_5f_float,
  CASE
    WHEN z.chokyo_den_chokyo3_course = '坂' THEN z.chokyo_den_chokyo3_5f
    WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_chokyo3_4f
  END AS chokyo_den_chokyo3_4f,
  CASE
    WHEN z.chokyo_den_chokyo3_course = '坂' THEN SAFE_CAST(z.chokyo_den_chokyo3_5f AS FLOAT64)
    WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_chokyo3_4f AS FLOAT64)
  END AS chokyo_den_chokyo3_4f_float,

  CASE
    WHEN z.chokyo_den_chokyo3_course = '坂' THEN z.chokyo_den_chokyo3_4f
    WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_chokyo3_3f
  END AS chokyo_den_chokyo3_3f,
  CASE
    WHEN z.chokyo_den_chokyo3_course = '坂' THEN SAFE_CAST(z.chokyo_den_chokyo3_4f AS FLOAT64)
    WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN NULL
    ELSE SAFE_CAST(z.chokyo_den_chokyo3_3f AS FLOAT64)
  END AS chokyo_den_chokyo3_3f_float,

  ROUND(
    CASE
      WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN NULL
      WHEN z.chokyo_den_chokyo3_course = '坂' THEN SAFE_CAST(z.chokyo_den_chokyo3_3f AS FLOAT64)
      ELSE SAFE_CAST(z.chokyo_den_chokyo3_3f AS FLOAT64) - (SAFE_CAST(z.chokyo_den_chokyo3_4f AS FLOAT64) - SAFE_CAST(z.chokyo_den_chokyo3_3f AS FLOAT64))
    END, 1
  ) AS chokyo_den_chokyo3_2f_float,

  CASE
    WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN NULL
    ELSE z.chokyo_den_chokyo3_1f
  END AS chokyo_den_chokyo3_1f,
  CASE WHEN z.chokyo_den_chokyo3_basho = 'プール' THEN NULL ELSE SAFE_CAST(z.chokyo_den_chokyo3_1f AS FLOAT64) END AS chokyo_den_chokyo3_1f_float,

  z.chokyo_den_chokyo3_ichidori,

  CASE z.chokyo_den_chokyo3_ichidori
     WHEN '1' THEN '①' WHEN '2' THEN '②' WHEN '3' THEN '③' WHEN '4' THEN '④' WHEN '5' THEN '⑤'
     WHEN '6' THEN '⑥' WHEN '7' THEN '⑦' WHEN '8' THEN '⑧' WHEN '9' THEN '⑨'
     ELSE z.chokyo_den_chokyo3_ichidori
  END AS chokyo_den_chokyo3_ichidori_label,

  z.chokyo_den_chokyo3_ashiiro,
  CASE z.chokyo_den_chokyo3_ashiiro
    WHEN '馬なり' THEN '馬なり' WHEN '馬ナリ' THEN '馬なり' WHEN '一 杯' THEN '一杯' WHEN '一杯' THEN '一杯'
    WHEN '強 め' THEN '強め' WHEN '強め' THEN '強め' WHEN '強目' THEN '強め' WHEN '末強め' THEN '末強め'
    WHEN '末強目' THEN '末強め' WHEN '直強め' THEN '直強め' WHEN '直強目' THEN '直強め' WHEN '叩一杯' THEN '叩一杯'
    WHEN '稍一杯' THEN '稍一杯' WHEN '末一杯' THEN '末一杯' WHEN '直一杯' THEN '直一杯' WHEN 'バテる' THEN 'バテる'
    WHEN '不明' THEN '不明' WHEN '不　明' THEN '不明' WHEN '不 明' THEN '不明' WHEN 'Ｇ前追' THEN 'G前追'
    WHEN '楽 走' THEN '楽走' WHEN '向正面' THEN '向正面' WHEN 'ササる' THEN 'ササる' WHEN '稍強め' THEN '稍強め'
    WHEN '止める' THEN '止める' WHEN 'バカ付' THEN 'バカ付' WHEN '引掛る' THEN '引掛る' WHEN '末抑え' THEN '末抑え'
    WHEN '直抑え' THEN '直抑え' WHEN '外逃げ' THEN '外逃げ' WHEN 'ヨレる' THEN 'ヨレる'
    ELSE z.chokyo_den_chokyo3_ashiiro
  END AS chokyo_den_chokyo3_ashiiro_label,
  z.chokyo_den_chokyo3_yajirushi,
  CASE z.chokyo_den_chokyo3_yajirushi
    WHEN '1' THEN '一変(↑)' WHEN '2' THEN '平行(→)' WHEN '3' THEN '下降(↓)' WHEN '4' THEN '良化(／)' WHEN '5' THEN '下降気味(＼)'
    ELSE NULL
  END AS chokyo_den_chokyo3_yajirushi_label,
  z.chokyo_den_chokyo3_reigai,
  z.speed_shisu1 AS speed_sisu_last_1,
  SAFE_CAST(z.speed_shisu1 AS FLOAT64) / 10 AS speed_sisu_last_1_float,
  z.speed_shisu2 AS speed_sisu_last_2,
  SAFE_CAST(z.speed_shisu2 AS FLOAT64) / 10 AS speed_sisu_last_2_float,
  z.speed_shisu3 AS speed_sisu_last_3,
  SAFE_CAST(z.speed_shisu3 AS FLOAT64) / 10 AS speed_sisu_last_3_float,
  z.speed_shisu4 AS speed_sisu_last_4,
  SAFE_CAST(z.speed_shisu4 AS FLOAT64) / 10 AS speed_sisu_last_4_float,
  z.speed_shisu5 AS speed_sisu_last_5,
  SAFE_CAST(z.speed_shisu5 AS FLOAT64) / 10 AS speed_sisu_last_5_float,
  z.rotation1,
  IF(SAFE_CAST(z.rotation1 AS INT64) IS NOT NULL, CAST(SAFE_CAST(z.rotation1 AS INT64) AS STRING), z.rotation1) AS rotation1_label,
  z.rotation2,
  IF(SAFE_CAST(z.rotation2 AS INT64) IS NOT NULL, CAST(SAFE_CAST(z.rotation2 AS INT64) AS STRING), z.rotation2) AS rotation2_label,
  z.rotation3,
  IF(SAFE_CAST(z.rotation3 AS INT64) IS NOT NULL, CAST(SAFE_CAST(z.rotation3 AS INT64) AS STRING), z.rotation3) AS rotation3_label,
  z.rotation4,
  IF(SAFE_CAST(z.rotation4 AS INT64) IS NOT NULL, CAST(SAFE_CAST(z.rotation4 AS INT64) AS STRING), z.rotation4) AS rotation4_label,
  z.rotation5,
  IF(SAFE_CAST(z.rotation5 AS INT64) IS NOT NULL, CAST(SAFE_CAST(z.rotation5 AS INT64) AS STRING), z.rotation5) AS rotation5_label,
  z.rotation6,
  IF(SAFE_CAST(z.rotation6 AS INT64) IS NOT NULL, CAST(SAFE_CAST(z.rotation6 AS INT64) AS STRING), z.rotation6) AS rotation6_label,
  z.rotation7,
  IF(SAFE_CAST(z.rotation7 AS INT64) IS NOT NULL, CAST(SAFE_CAST(z.rotation7 AS INT64) AS STRING), z.rotation7) AS rotation7_label,
  z.rotation8,
  IF(SAFE_CAST(z.rotation8 AS INT64) IS NOT NULL, CAST(SAFE_CAST(z.rotation8 AS INT64) AS STRING), z.rotation8) AS rotation8_label,
    CASE
    WHEN z.rotation1 IS NOT NULL THEN '連闘'
    WHEN z.rotation2 IS NOT NULL THEN '中1週'
    WHEN z.rotation3 IS NOT NULL THEN '中2週'
    WHEN z.rotation4 IS NOT NULL THEN '中3週'
    WHEN z.rotation5 IS NOT NULL THEN '中4週'
    WHEN z.rotation6 IS NOT NULL THEN '中5週'
    WHEN z.rotation7 IS NOT NULL THEN '中6週'
    WHEN z.rotation8 IS NOT NULL THEN '中7週'
    ELSE NULL
  END AS zensou_kankaku,
  CASE
    WHEN z.toroku_tosu_num <= 8 THEN '中'
    WHEN z.wakuban = '1' THEN '内枠'
    WHEN z.wakuban = '8' THEN '外枠'
    ELSE '中'
  END AS waku_kubun,
  z.bataiju,
  CASE
    WHEN SAFE_CAST(z.bataiju AS INT64) >= 500 THEN '500kg以上'
    WHEN SAFE_CAST(z.bataiju AS INT64) BETWEEN 480 AND 499 THEN '480～499kg'
    WHEN SAFE_CAST(z.bataiju AS INT64) BETWEEN 460 AND 479 THEN '460～479kg'
    WHEN SAFE_CAST(z.bataiju AS INT64) BETWEEN 440 AND 459 THEN '440～459kg'
    WHEN SAFE_CAST(z.bataiju AS INT64) < 440 THEN '439kg以下'
    ELSE NULL
  END AS bataiju_kubun,
  z.bataiju_zensou,
  CASE
    WHEN SAFE_CAST(z.bataiju_zensou AS INT64) >= 500 THEN '500kg以上'
    WHEN SAFE_CAST(z.bataiju_zensou AS INT64) BETWEEN 480 AND 499 THEN '480～499kg'
    WHEN SAFE_CAST(z.bataiju_zensou AS INT64) BETWEEN 460 AND 479 THEN '460～479kg'
    WHEN SAFE_CAST(z.bataiju_zensou AS INT64) BETWEEN 440 AND 459 THEN '440～459kg'
    WHEN SAFE_CAST(z.bataiju_zensou AS INT64) < 440 THEN '439kg以下'
    ELSE NULL
  END AS bataiju_kubun_zensou,
  CASE
    WHEN MOD(SAFE_CAST(z.umaban AS INT64), 2) = 0 THEN 'はい'
    ELSE 'いいえ'
  END AS umaban_even,
  z.kyori_kubun_zensou,
  CASE
    WHEN z.kyori > z.kyori_zensou THEN 'はい'
    ELSE 'いいえ'
  END AS kyori_extension_flag,
  CASE
    WHEN z.kyori < z.kyori_zensou THEN 'はい'
    ELSE 'いいえ'
  END AS kyori_shortening_flag,
  CASE
    WHEN (z.chokyoshi_tracen_kubun = '1' AND z.keibajo_code IN ('04', '05', '07', '06')) THEN 'はい'
    ELSE 'いいえ'
  END AS ensei_kansai_to_kantou_flag,
  CASE
    WHEN z.chokyoshi_tracen_kubun IN ('2', '3') AND z.keibajo_code IN ('00', '01', '03', '02') THEN 'はい'
    ELSE 'いいえ'
  END AS ensei_kantou_to_kansai_flag,
  CASE
    WHEN
      (z.chokyoshi_tracen_kubun = '1' AND z.keibajo_code IN ('04', '05', '07', '06'))
      OR (z.chokyoshi_tracen_kubun IN ('2', '3') AND z.keibajo_code IN ('00', '01', '03', '02'))
    THEN 'はい'
    ELSE 'いいえ'
  END AS ensei_flag,
  z.track_code1_label_dirtsiba_zensou,
  CASE
    WHEN z.track_code1_label_dirtsiba_zensou = '芝' AND z.track_code1_dirtsiba_label = 'ダ' THEN 'はい'
    ELSE 'いいえ'
  END AS siba_to_dirt_flag,
  CASE
    WHEN z.track_code1_label_dirtsiba_zensou = 'ダ' AND z.track_code1_dirtsiba_label = '芝' THEN 'はい'
    ELSE 'いいえ'
  END AS dirt_to_siba_flag,
  z.record_shisu,
  SAFE_CAST(z.record_shisu AS INT64) AS record_shisu_num,
  z.zogen_sa,
  SAFE_CAST(z.zogen_sa AS INT64) AS zogen_sa_num,
  SAFE_CAST(odds.TanshoNinkijun AS INT64) AS sokuhou_tansho_ninkijun_num,
  SAFE_CAST(odds.TanshoOdds AS FLOAT64) AS sokuhou_tansho_odds_float,
  FORMAT_TIMESTAMP('%H:%M', odds.HappyoTsukihiJifun, 'Asia/Tokyo') AS sokuhou_happyo_tsukihi_jifun,
  CASE
    WHEN z.tansho_ninkijun IN ('34', '35') THEN '00'
    ELSE z.tansho_ninkijun
  END AS kakutei_tansho_ninkijun,
  CASE
    WHEN z.tansho_ninkijun IN ('34', '35') THEN 0
    ELSE SAFE_CAST(z.tansho_ninkijun AS INT64)
  END AS kakutei_tansho_ninkijun_num,
  z.tansho_odds AS kakutei_tansho_odds,
  SAFE_CAST(z.tansho_odds AS FLOAT64) / 10 AS kakutei_tansho_odds_float,
  z.kakutei_chakujun,
  SAFE_CAST(z.kakutei_chakujun AS INT64) AS kakutei_chakujun_num,
  CASE -- 修正ロジック: 確定着順が '1' の場合のみ払戻金のNULL判定を行い、それ以外は '0'
    WHEN z.kakutei_chakujun IN ('01') THEN
      CASE
        WHEN z.tansho3_umaban IS NOT NULL THEN z.tansho3_haraimodoshikin
        WHEN z.tansho2_umaban IS NOT NULL THEN z.tansho2_haraimodoshikin
        WHEN z.tansho1_umaban IS NOT NULL THEN z.tansho1_haraimodoshikin
        ELSE '0'
      END
    ELSE '0'
  END AS tansho_haraimodoshi,
  SAFE_CAST(
    CASE -- 修正ロジック (数値型)
      WHEN z.kakutei_chakujun IN ('01') THEN
        CASE
          WHEN z.tansho3_umaban IS NOT NULL THEN z.tansho3_haraimodoshikin
          WHEN z.tansho2_umaban IS NOT NULL THEN z.tansho2_haraimodoshikin
          WHEN z.tansho1_umaban IS NOT NULL THEN z.tansho1_haraimodoshikin
          ELSE '0'
        END
      ELSE '0'
    END
  AS INT64) AS tansho_haraimodoshi_num,
  CASE -- 修正ロジック: 確定着順が '1', '2', '3' の場合のみ払戻金のNULL判定を行い、それ以外は '0'
    WHEN z.kakutei_chakujun IN ('01', '02', '03') THEN
      CASE
        WHEN z.fukusho5_umaban IS NOT NULL THEN z.fukusho5_haraimodoshikin
        WHEN z.fukusho4_umaban IS NOT NULL THEN z.fukusho4_haraimodoshikin
        WHEN z.fukusho3_umaban IS NOT NULL THEN z.fukusho3_haraimodoshikin
        WHEN z.fukusho2_umaban IS NOT NULL THEN z.fukusho2_haraimodoshikin
        WHEN z.fukusho1_umaban IS NOT NULL THEN z.fukusho1_haraimodoshikin
        ELSE '0'
      END
    ELSE '0'
  END AS fukusho_haraimodoshi,
  SAFE_CAST(
    CASE -- 修正ロジック (数値型)
      WHEN z.kakutei_chakujun IN ('01', '02', '03') THEN
        CASE
          WHEN z.fukusho5_umaban IS NOT NULL THEN z.fukusho5_haraimodoshikin
          WHEN z.fukusho4_umaban IS NOT NULL THEN z.fukusho4_haraimodoshikin
          WHEN z.fukusho3_umaban IS NOT NULL THEN z.fukusho3_haraimodoshikin
          WHEN z.fukusho2_umaban IS NOT NULL THEN z.fukusho2_haraimodoshikin
          WHEN z.fukusho1_umaban IS NOT NULL THEN z.fukusho1_haraimodoshikin
          ELSE '0'
        END
      ELSE '0'
    END
  AS INT64) AS fukusho_haraimodoshi_num,
  z.ijo_kubun_code1,
  CASE z.ijo_kubun_code1
    WHEN '1' THEN '落馬'
    WHEN '2' THEN '失格'
    WHEN '3' THEN '中止'
    WHEN '4' THEN '取消'
    WHEN '5' THEN '除外'
    WHEN '6' THEN '降着'
    WHEN '7' THEN '繰上げ'
    ELSE NULL
  END AS ijo_kubun_code1_label,
  z.ijo_kubun_code2,
  CASE z.ijo_kubun_code2
    WHEN '01' THEN '出走取消'
    WHEN '02' THEN '出走除外'
    WHEN '03' THEN '競走除外'
    WHEN '04' THEN '競走中止'
    WHEN '05' THEN '放馬'
    WHEN '06' THEN '発走除外'
    ELSE NULL
  END AS ijo_kubun_code2_label,
  z.nyusen_juni,
  SAFE_CAST(z.nyusen_juni AS INT64) AS nyusen_juni_num,
  z.record_flag,
  CASE
    WHEN z.record_flag = '1' THEN 'はい'
    ELSE 'いいえ'
  END AS record_flag_label,
  z.soha_time,
  SUBSTR(z.soha_time, 1, 1) || '分' || SUBSTR(z.soha_time, 2, 2) || '.' || SUBSTR(z.soha_time, 4, 1) || '秒' AS soha_time_label,
  SAFE_CAST(SUBSTR(z.soha_time, 1, 1) AS FLOAT64) * 60 + SAFE_CAST(SUBSTR(z.soha_time, 2, 2) AS FLOAT64) + SAFE_CAST(SUBSTR(z.soha_time, 4, 1) AS FLOAT64) / 10 AS soha_time_float,
  z.chakusa_code1,
  SAFE_CAST(z.chakusa_code1 AS INT64) AS chakusa_code1_num,
  z.chakusa_code2,
  CASE z.chakusa_code2
    WHEN '0' THEN 'ハナ'
    WHEN '1' THEN 'アタマ'
    WHEN '2' THEN 'クビ'
    WHEN '3' THEN '1/2'
    WHEN '4' THEN '1/4'
    WHEN '5' THEN '3/4'
    WHEN '7' THEN '大差'
    WHEN '8' THEN '同着'
    ELSE NULL
  END AS chakusa_code2_label,
  NULLIF(
    CASE
      WHEN z.chakusa_code1 IS NOT NULL AND z.chakusa_code1 != ' '
      THEN CAST(SAFE_CAST(z.chakusa_code1 AS INT64) AS STRING) || '馬身'
      ELSE ''
    END ||
    CASE z.chakusa_code2
      WHEN '0' THEN 'ハナ'
      WHEN '1' THEN 'アタマ'
      WHEN '2' THEN 'クビ'
      WHEN '3' THEN '1/2'
      WHEN '4' THEN '1/4'
      WHEN '5' THEN '3/4'
      WHEN '7' THEN '大差'
      WHEN '8' THEN '同着'
      ELSE ''
    END,
  '') AS chakusa_label,
  z.time_sa,
  SAFE_CAST(z.time_sa AS FLOAT64) / 10 AS time_sa_float,
  z.zenhan_3f,
  SAFE_CAST(z.zenhan_3f AS FLOAT64) / 10 AS zenhan_3f_float,
  z.kohan_3f,
  SAFE_CAST(z.kohan_3f AS FLOAT64) / 10 AS kohan_3f_float,
  z.corner1_juni,
  CASE
    WHEN SAFE_CAST(z.corner1_juni AS INT64) IS NULL THEN z.corner1_juni
    ELSE LPAD(z.corner1_juni, 2, '0')
  END AS corner1_juni_label,
  z.corner2_juni,
  CASE
    WHEN SAFE_CAST(z.corner2_juni AS INT64) IS NULL THEN z.corner2_juni
    ELSE LPAD(z.corner2_juni, 2, '0')
  END AS corner2_juni_label,
  z.corner3_juni,
  CASE
    WHEN SAFE_CAST(z.corner3_juni AS INT64) IS NULL THEN z.corner3_juni
    ELSE LPAD(z.corner3_juni, 2, '0')
  END AS corner3_juni_label,
  z.corner4_juni,
  CASE
    WHEN SAFE_CAST(z.corner4_juni AS INT64) IS NULL THEN z.corner4_juni
    ELSE LPAD(z.corner4_juni, 2, '0')
  END AS corner4_juni_label,
  z.corner4_ichidori,
  CASE z.corner4_ichidori
    WHEN '1' THEN '最内'
    WHEN '2' THEN '内'
    WHEN '3' THEN '中'
    WHEN '4' THEN '外'
    WHEN '5' THEN '大外'
    ELSE NULL
  END AS corner4_ichidori_label,
  z.comment_kishu_kyusha,
  z.comment_next,
  z.comment_last,
  CAST(z.YosouTanNinki AS INT64) AS yosou_tansho_ninkijun_num,
  CAST(z.YosouTanOdds AS FLOAT64) AS yosou_tansho_odds_float,
  sc.shirushi_hanro_4f_flag,
  sc.shirushi_hanro_1f_flag,
  sc.shirushi_wood_6f_flag,
  sc.shirushi_wood_1f_flag,
  sc.shirushi_awase_senchaku_flag,
  sc.shirushi_point,
  sc.shirushi_kubun_yosou_tansho_ninkijun,
  sc.shirushi_kubun_rank,
  sc.shirushi_shirushi_label,
  sc.shirushi_shirushi_num,
  CURRENT_TIMESTAMP() AS created,
  CURRENT_TIMESTAMP() AS modified
FROM
  with_zensou_data AS z
LEFT JOIN
  partner_lookup AS pl
  ON z.race_code_uma_kol = pl.race_code_uma_kol

LEFT JOIN
  shirushi_final AS sc
  ON z.race_code_uma_kol = sc.race_code_uma_kol
LEFT JOIN
  ${ref("races_uma_odds_jvd_new")} AS odds
  ON odds.RaceUmaCode = z.race_code_uma_kol