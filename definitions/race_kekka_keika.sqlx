-- =================================================================
-- race_kekka_keika.sqlx
-- 説明: kol_sei1のレース経過情報（race_keika1～9）をアンピボットして
--       レースごとの経過情報を整形したテーブル。
-- =================================================================

config {
  type: "table",
  description: "競走成績レース面（kol_sei1）のレース経過情報（race_keika1～9）を連番単位に展開したテーブル。",
  columns: {
    race_code_kol: "KOL仕様馬毎レースID 年月日8桁+KOL仕様開催場所コード2桁+開催回次2桁+開催日次2桁+レース番号2桁",
    race_code_jvd: "JRA-VAN仕様 年4桁+月2桁+日2桁+JRA-VAN仕様競馬場コード2桁+回次2桁+日次2桁+レース番号2桁",
    schedule_id: "発走日8文字 YYYYMMDD",
    schedule_date: "発送日0時0分 date型",
    hasso_date: "発走日時のUTC時刻から9時間経過。 kaisai_nen ・ kaisai_nichiji ・ hasso_jikokuから算出",
    hasso_date_utc: "発走日時のUTC時刻",
    keika: "経過情報 (ex)11.12-2(1.3.13)(8.10)(7.9.5)-4.6",
    keika_midashi1: "経過情報 見出し1",
    keika_midashi2: "経過情報 見出し2",
    keika_sort_label: "角 (ex)ソート用の連番が1のとき 角1",
    keika_sort_num: "経過情報 ソート用の連番 1～9"
  },
  bigquery: {
    partitionBy: "schedule_date"
  }
}

WITH
  -- kol_sei1から経過情報を取得
  sei1_base AS (
    SELECT
      s1.race_code_kol,
      s1.race_keika1_keika_midashi1,
      s1.race_keika1_keika_midashi2,
      s1.race_keika1_keika,
      s1.race_keika2_keika_midashi1,
      s1.race_keika2_keika_midashi2,
      s1.race_keika2_keika,
      s1.race_keika3_keika_midashi1,
      s1.race_keika3_keika_midashi2,
      s1.race_keika3_keika,
      s1.race_keika4_keika_midashi1,
      s1.race_keika4_keika_midashi2,
      s1.race_keika4_keika,
      s1.race_keika5_keika_midashi1,
      s1.race_keika5_keika_midashi2,
      s1.race_keika5_keika,
      s1.race_keika6_keika_midashi1,
      s1.race_keika6_keika_midashi2,
      s1.race_keika6_keika,
      s1.race_keika7_keika_midashi1,
      s1.race_keika7_keika_midashi2,
      s1.race_keika7_keika,
      s1.race_keika8_keika_midashi1,
      s1.race_keika8_keika_midashi2,
      s1.race_keika8_keika,
      s1.race_keika9_keika_midashi1,
      s1.race_keika9_keika_midashi2,
      s1.race_keika9_keika
    FROM ${ref("kol_sei1")} AS s1
  ),

  -- kol_den1からレース基本情報を取得
  den1_base AS (
    SELECT
      d1.race_code_kol,
      d1.keibajo_code,
      d1.kaisai_nengappi,
      d1.hasso_jikoku,
      d1.kaisai_kaiji,
      d1.kaisai_nichiji,
      d1.race_num,
      -- KOL → JRA-VAN 競馬場コード変換
      CASE d1.keibajo_code
        WHEN '08' THEN '01' -- 札幌
        WHEN '09' THEN '02' -- 函館
        WHEN '06' THEN '03' -- 福島
        WHEN '07' THEN '04' -- 新潟
        WHEN '04' THEN '05' -- 東京
        WHEN '05' THEN '06' -- 中山
        WHEN '02' THEN '07' -- 中京
        WHEN '00' THEN '08' -- 京都
        WHEN '01' THEN '09' -- 阪神
        WHEN '03' THEN '10' -- 小倉
        ELSE NULL
      END AS keibajo_code_jvd
    FROM ${ref("kol_den1")} AS d1
  ),

  -- SEI1とDEN1を結合してデータを準備
  joined AS (
    SELECT
      s1.*,
      d1.keibajo_code_jvd,
      d1.kaisai_nengappi AS kaisai_nengappi_str,
      d1.hasso_jikoku,
      d1.kaisai_kaiji,
      d1.kaisai_nichiji,
      d1.race_num
    FROM sei1_base AS s1
    LEFT JOIN den1_base AS d1
      ON s1.race_code_kol = d1.race_code_kol
  ),

  -- 経過情報をアンピボット (race_keika1～9 → 行展開)
  unpivoted AS (
    SELECT * FROM joined
    CROSS JOIN UNNEST([
      STRUCT(1 AS keika_sort_num, race_keika1_keika AS keika_text, race_keika1_keika_midashi1 AS midashi1, race_keika1_keika_midashi2 AS midashi2),
      STRUCT(2 AS keika_sort_num, race_keika2_keika AS keika_text, race_keika2_keika_midashi1 AS midashi1, race_keika2_keika_midashi2 AS midashi2),
      STRUCT(3 AS keika_sort_num, race_keika3_keika AS keika_text, race_keika3_keika_midashi1 AS midashi1, race_keika3_keika_midashi2 AS midashi2),
      STRUCT(4 AS keika_sort_num, race_keika4_keika AS keika_text, race_keika4_keika_midashi1 AS midashi1, race_keika4_keika_midashi2 AS midashi2),
      STRUCT(5 AS keika_sort_num, race_keika5_keika AS keika_text, race_keika5_keika_midashi1 AS midashi1, race_keika5_keika_midashi2 AS midashi2),
      STRUCT(6 AS keika_sort_num, race_keika6_keika AS keika_text, race_keika6_keika_midashi1 AS midashi1, race_keika6_keika_midashi2 AS midashi2),
      STRUCT(7 AS keika_sort_num, race_keika7_keika AS keika_text, race_keika7_keika_midashi1 AS midashi1, race_keika7_keika_midashi2 AS midashi2),
      STRUCT(8 AS keika_sort_num, race_keika8_keika AS keika_text, race_keika8_keika_midashi1 AS midashi1, race_keika8_keika_midashi2 AS midashi2),
      STRUCT(9 AS keika_sort_num, race_keika9_keika AS keika_text, race_keika9_keika_midashi1 AS midashi1, race_keika9_keika_midashi2 AS midashi2)
    ]) AS t
    WHERE t.keika_text IS NOT NULL AND t.keika_text != ''
  )

-- 最終SELECT
SELECT
  u.race_code_kol,
  -- JRA-VAN仕様 年4桁+月2桁+日2桁+JRA-VAN仕様競馬場コード2桁+回次2桁+日次2桁+レース番号2桁
  u.kaisai_nengappi_str || u.keibajo_code_jvd || u.kaisai_kaiji || u.kaisai_nichiji || u.race_num AS race_code_jvd,
  -- 発走日8文字 YYYYMMDD
  u.kaisai_nengappi_str AS schedule_id,
  -- 発走日0時0分 date型
  DATE(PARSE_DATETIME('%Y%m%d%H%M', u.kaisai_nengappi_str || REPLACE(u.hasso_jikoku, ':', ''))) AS schedule_date,
  -- 発走日時 (JST)
  PARSE_DATETIME('%Y%m%d%H%M', u.kaisai_nengappi_str || REPLACE(u.hasso_jikoku, ':', '')) AS hasso_date,
  -- 発走日時 (UTC)
  DATETIME_ADD(PARSE_DATETIME('%Y%m%d%H%M', u.kaisai_nengappi_str || REPLACE(u.hasso_jikoku, ':', '')), INTERVAL -9 HOUR) AS hasso_date_utc,
  -- 経過情報
  u.keika_text AS keika,
  u.midashi1 AS keika_midashi1,
  u.midashi2 AS keika_midashi2,
  -- 角 (ex)ソート用の連番が1のとき 角1
  CONCAT('角', CAST(u.keika_sort_num AS STRING)) AS keika_sort_label,
  -- 経過情報 ソート用の連番 1～9
  u.keika_sort_num
FROM unpivoted AS u
WHERE u.kaisai_nengappi_str >= '20230101'
