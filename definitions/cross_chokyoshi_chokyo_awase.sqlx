-- =================================================================
-- cross_chokyoshi_chokyo_awase.sqlx
-- 説明: 調教師と調教併せの組み合わせごとに単勝・複勝払戻金合計、着順別回数を算出するテーブル。
-- =================================================================

config {
  type: "table",
  description: "調教師と調教併せごとの成績集計",
  columns: {
    chokyoshi_code: "調教師コード",
    chokyoshimei: "調教師名",
    chokyo_den_awase_kubun: "出馬表出走馬データ 調教併せ区分 chokyo_awaseをもとに対応 併せ同入/併せ遅れ/併せ先着/単走",
    chokyo_den_awase_uma_kakuue_win_flag: "出馬表出走馬データ 調教併せ馬 格上に対して先着した場合は「はい」該当しない場合はnull",
    chokyo_sei_ichidori: "競走成績出走馬データ 追い切り 1～9",
    chokyo_den_ichidori_furi_win_flag: "併せ馬が存在し、かつchokyo_ichidoriが6〜9（大外回り）かつ併せ先着の場合「はい」該当しない場合はnull",
    total_tansho_haraimodoshi: "単勝払戻金合計",
    total_fukusho_haraimodoshi: "複勝払戻金合計",
    count_1chaku: "1着回数",
    count_2chaku: "2着回数",
    count_3chaku: "3着回数",
    count_4chaku_ika: "4着以下回数",
    count_total_races: "総レース数"
  }
}

SELECT
  chokyoshi_code,
  ARRAY_AGG(chokyoshimei ORDER BY hasso_date DESC LIMIT 1)[OFFSET(0)] AS chokyoshimei,
  chokyo_den_awase_kubun,
  chokyo_den_awase_uma_kakuue_win_flag,
  chokyo_sei_ichidori,
  chokyo_den_ichidori_furi_win_flag,
  SUM(tansho_haraimodoshi_num) AS total_tansho_haraimodoshi,
  SUM(fukusho_haraimodoshi_num) AS total_fukusho_haraimodoshi,
  COUNTIF(kakutei_chakujun_num = 1) AS count_1chaku,
  COUNTIF(kakutei_chakujun_num = 2) AS count_2chaku,
  COUNTIF(kakutei_chakujun_num = 3) AS count_3chaku,
  COUNTIF(kakutei_chakujun_num >= 4) AS count_4chaku_ika,
  COUNT(*) AS count_total_races
FROM
  ${ref("race_uma_detail_looker")}
WHERE
  chokyoshi_code IS NOT NULL
  AND chokyo_den_awase_kubun IS NOT NULL
  AND kakutei_chakujun_num >= 1
  AND hasso_date >= DATE_TRUNC(DATE_SUB(CURRENT_DATE('Asia/Tokyo'), INTERVAL 3 YEAR), YEAR)
  AND hasso_date < DATE_TRUNC(CURRENT_DATE('Asia/Tokyo'), YEAR)
GROUP BY
  chokyoshi_code,
  chokyo_den_awase_kubun,
  chokyo_den_awase_uma_kakuue_win_flag,
  chokyo_sei_ichidori,
  chokyo_den_ichidori_furi_win_flag
